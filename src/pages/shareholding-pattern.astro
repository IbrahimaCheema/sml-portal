---
import Layout from '../layouts/Layout.astro';

// Page Metadata
const pageTitle = "Shareholding Pattern | Shakarganj Limited";
const metaDescription = "Official pattern of shareholding, distribution of equity shares, categories of shareholders, and capital structure details for Shakarganj Limited.";

// Cloudflare R2 hosted PDF & local fallback
const pdfUrl = "https://docs.sml.com.pk/docs/SML-Shareholding-Pattern.pdf";
const localPdfUrl = "https://docs.sml.com.pk/docs/SML-Shareholding-Pattern.pdf";
---

<Layout title={pageTitle} description={metaDescription}>
  <!-- Modernized Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_content_flex">
        <div class="hero_text_box">
          <div class="hero_breadcrumbs">
            <a href="/">Home</a> <i class="fa fa-angle-right"></i>
            <span>Investor Relations</span> <i class="fa fa-angle-right"></i>
            <span class="current">Shareholding Pattern</span>
          </div>
          <h1 class="hero_page_title">Shareholding Pattern</h1>
          <p class="hero_subtitle">
            Official pattern of shareholding, distribution of equity shares among directors, executives, associated companies, financial institutions, and general public for Shakarganj Limited.
          </p>
        </div>

        <div class="hero_actions">
          <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="btn_action download_btn" download="SML-Shareholding-Pattern.pdf">
            <i class="fa fa-download"></i> Download PDF
          </a>
          <a href={pdfUrl} target="_blank" rel="noopener noreferrer" class="btn_action fullscreen_btn">
            <i class="fa fa-external-link"></i> Open Fullscreen
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- PDF Viewer Section -->
  <section class="pdf_viewer_section">
    <div class="container">
      
      <!-- Viewer Container Card -->
      <div class="pdf_card_wrapper">
        <!-- Embedded Full Page PDF Viewer (Toolbar Hidden for Pure Content View) -->
        <div class="pdf_embed_container">
          <object
            data={`${pdfUrl}#toolbar=0&navpanes=0&scrollbar=1&view=FitH`}
            type="application/pdf"
            class="pdf_object"
          >
            <iframe 
              src={`${pdfUrl}#toolbar=0&navpanes=0&scrollbar=1&view=FitH`}
              title="Shakarganj Limited Shareholding Pattern PDF"
              class="pdf_iframe"
              loading="lazy"
            >
              <p>Your browser does not support embedded PDF viewing. 
                <a href={pdfUrl} target="_blank" rel="noopener noreferrer">Click here to view or download the PDF document directly.</a>
              </p>
            </iframe>
          </object>
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Hero Section */
  /* Page Hero Banner */
  .page_hero_banner {
    background: linear-gradient(135deg, #004d00 0%, #002b00 100%);
    color: #ffffff;
    padding: 55px 0 45px;
    border-bottom: 3px solid var(--primary-color);
  }
  .hero_breadcrumbs {
    font-size: 13px;
    color: #a0c8a0;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hero_breadcrumbs a {
    color: #a0c8a0;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .hero_breadcrumbs a:hover {
    color: #ffffff;
  }
  .hero_breadcrumbs .current {
    color: #ffffff;
    font-weight: 600;
  }
  .hero_page_title {
    font-size: 36px;
    font-family: var(--font-heading);
    font-weight: 700;
    margin-bottom: 10px;
    line-height: 1.2;
    color: #ffffff;
  }
  .hero_subtitle {
    font-size: 16px;
    color: #e0f0e0;
    max-width: 750px;
    line-height: 1.5;
    margin: 0;
  }
  .hero_content_flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    flex-wrap: wrap;
  }
  .hero_text_box {
    max-width: 750px;
  }

  .hero_actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .btn_action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .download_btn {
    background: var(--primary-color);
    color: #ffffff;
    border: none;
    box-shadow: 0 4px 12px rgba(46, 125, 50, 0.3);
  }

  .download_btn:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
  }

  .fullscreen_btn {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .fullscreen_btn:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  /* PDF Viewer Section */
  .pdf_viewer_section {
    padding: 40px 0 60px 0;
    background: #f8fafc;
  }

  .pdf_card_wrapper {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #cbd5e0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .pdf_embed_container {
    width: 100%;
    height: clamp(600px, 82vh, 1050px);
    background: #525659;
    position: relative;
    overflow: hidden;
  }

  .pdf_object,
  .pdf_iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    overflow: hidden;
  }

  .pdf_card_footer {
    padding: 14px 20px;
    background: #f1f5f9;
    border-top: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer_note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #475569;
  }

  .footer_note i {
    color: var(--primary-color);
  }

  .direct_link {
    font-size: 13px;
    font-weight: 600;
    color: #1e293b;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease;
  }

  .direct_link:hover {
    color: var(--primary-color);
  }

  /* Responsive Styling */
  @media (max-width: 768px) {
    .pattern_hero {
      padding: 25px 0 35px 0;
    }

    .hero_title {
      font-size: 24px;
    }

    .hero_content_flex {
      flex-direction: column;
      align-items: stretch;
    }

    .hero_actions {
      width: 100%;
      justify-content: flex-start;
    }

    .pdf_embed_container {
      height: 600px;
    }
  }
</style>
