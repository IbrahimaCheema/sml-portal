---

<Layout title="Historical Financial Reports - Shakarganj Limited">
  <!-- Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <i class="fa fa-angle-right"></i>
        <span>About Us</span> <i class="fa fa-angle-right"></i>
        <span class="current">Historical Reports</span>
      </div>
      <h1 class="hero_page_title">Historical Financial Reports</h1>
      <p class="hero_subtitle">Complete 38-Year Financial Statements Archive of Shakarganj Limited (1979 – 2016) documenting over 45 years of industrial excellence.</p>
      
      <!-- Key Financial Metrics Ribbon -->
      <div class="metrics_ribbon">
        <div class="metric_item">
          <i class="fa fa-history"></i>
          <div>
            <strong>Historical Archive</strong>
            <span>1979 – 2016 (38 Years)</span>
          </div>
        </div>
        <div class="metric_item">
          <i class="fa fa-archive"></i>
          <div>
            <strong>Total Statements</strong>
            <span>60+ Audited Reports</span>
          </div>
        </div>
        <div class="metric_item">
          <i class="fa fa-line-chart"></i>
          <div>
            <strong>PSX Symbol</strong>
            <span>SML (Listed 1967)</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Financial Reports Section -->
  <section class="financial_section">
    <div class="container">

      <!-- Navigation & Year Selection Bar -->
      <div class="year_tabs_container">
        <div class="top_actions_bar">
          <a href="/financial-reports" class="year_tab_btn current_reports_btn">
            <i class="fa fa-arrow-left"></i> Back to Current Reports (2017–2026)
          </a>
          <span class="tabs_label"><i class="fa fa-filter"></i> Select Historical Year:</span>
        </div>
        
        <div class="year_tabs historical_year_tabs">
          {historicalReportsData.map((yData, idx) => (
            <button 
              class={`year_tab_btn ${idx === 0 ? 'active' : ''}`}
              data-year={yData.year}
            >
              <i class="fa fa-folder-o"></i> {yData.year}
            </button>
          ))}
        </div>
      </div>

      <!-- Year Content Panels -->
      <div class="year_panels_container">
        {historicalReportsData.map((yData, idx) => (
          <div 
            class={`year_panel ${idx === 0 ? 'active' : ''}`}
            id={`panel_${yData.year}`}
          >
            <div class="panel_header">
              <h2><i class="fa fa-calendar-check-o"></i> FY {yData.year} Historical Reports</h2>
              <span class="reports_count_badge">{yData.reports.length} Report(s) Available</span>
