---
import Layout from '../layouts/Layout.astro';

// Page Metadata
const pageTitle = "Company Profile & Overview | Shakarganj Limited (SML)";
const metaDescription = "Explore the official corporate profile of Shakarganj Limited (SML), incorporated in 1967. Learn about our leadership in refined sugar, bioethanol, and agro-industrial innovation in Pakistan.";

// Cloudflare R2 Image Endpoints & Local Fallbacks
const sugarImgUrl = "https://docs.sml.com.pk/images/company_profile_sugar.jpg";
const sugarImgLocal = "https://docs.sml.com.pk/images/company_profile_sugar.jpg";
const biofuelImgUrl = "https://docs.sml.com.pk/images/company_profile_biofuel.jpg";
const biofuelImgLocal = "https://docs.sml.com.pk/images/company_profile_biofuel.jpg";
---

<Layout title={pageTitle} description={metaDescription}>
  <!-- Modernized Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <i class="fa fa-angle-right"></i>
        <span>About Us</span> <i class="fa fa-angle-right"></i>
        <span class="current">Company's Profile</span>
      </div>
      <h1 class="hero_page_title">Company's Profile</h1>
      <p class="hero_subtitle">Leading Pakistan's renewable agro-industrial transformation since 1967 with premier manufacturing in refined sugar and biofuels.</p>
    </div>
  </section>

  <!-- Profile Content Section -->
  <section class="profile_main_section">
    <div class="container">
      
      <!-- Executive Overview Card -->
      <div class="overview_card">
        <div class="overview_header">
          <div class="overview_icon logo_box">
            <img src="https://docs.sml.com.pk/images/sml_official_logo.jpg" alt="Shakarganj Logo Icon" width="40" height="40" onerror="this.onerror=null; this.src='https://docs.sml.com.pk/images/logo.png'" />
          </div>
          <div>
            <h2 class="overview_title">Profile of Company</h2>
            <span class="overview_tagline">Shakarganj Limited (PSX: SML)</span>
          </div>
        </div>

        <div class="overview_body">
          <p>
            <strong>Shakarganj Limited</strong>, incorporated in 1967, is listed on the Pakistan Stock Exchange with the trading symbol <strong>SML</strong>. The company is a recognized market leader across key agro-industrial business sectors, transforming renewable crops such as sugarcane into high-value added products comprising refined sugar and biofuels.
          </p>
          <p>
            Shakarganj operates two state-of-the-art manufacturing complexes strategically located in the Jhang District of Punjab, supported by a registered Head Office in Lahore.
          </p>
        </div>
      </div>

      <!-- Corporate Information Grid -->
      <div class="meta_section">
        <h3 class="section_heading">Corporate Information & Regulatory Credentials</h3>
        <div class="meta_grid">
          
          <div class="meta_card">
            <div class="meta_icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <div class="meta_info">
              <span class="meta_label">Registration Number</span>
              <span class="meta_value">0002546</span>
            </div>
          </div>

          <div class="meta_card">
            <div class="meta_icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>
            <div class="meta_info">
              <span class="meta_label">National Tax Number (NTN)</span>
              <span class="meta_value">1413603-1</span>
            </div>
          </div>

          <div class="meta_card">
            <div class="meta_icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                <line x1="8" y1="6" x2="16" y2="6"></line>
                <line x1="16" y1="14" x2="16" y2="18"></line>
                <path d="M16 10h.01"></path>
                <path d="M12 10h.01"></path>
                <path d="M8 10h.01"></path>
                <path d="M12 14h.01"></path>
                <path d="M8 14h.01"></path>
                <path d="M12 18h.01"></path>
                <path d="M8 18h.01"></path>
              </svg>
            </div>
            <div class="meta_info">
              <span class="meta_label">Sales Tax Number (STRN)</span>
              <span class="meta_value">04-06-1703-002-46</span>
            </div>
          </div>

          <div class="meta_card">
            <div class="meta_icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <div class="meta_info">
              <span class="meta_label">Incorporation Date</span>
              <span class="meta_value">20 September 1967</span>
            </div>
          </div>

          <div class="meta_card">
            <div class="meta_icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <div class="meta_info">
              <span class="meta_label">PSX Symbol</span>
              <span class="meta_value symbol_tag">SML</span>
            </div>
          </div>

          <div class="meta_card">
            <div class="meta_icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="meta_info">
              <span class="meta_label">Official Contact</span>
              <a href="mailto:info@shakarganj.pk" class="meta_link">info@shakarganj.pk</a>
            </div>
          </div>

        </div>
      </div>

      <!-- Business Activities Section (Ignoring Textile as instructed) -->
      <div class="activities_section">
        <div class="activities_header">
          <h3 class="section_heading">Core Business Activities</h3>
          <p class="section_sub">Discover our primary industrial production segments transforming natural resources.</p>
        </div>

        <div class="activities_grid">
          
          <!-- Sugar Card -->
          <div class="activity_card">
            <div class="activity_image_box">
              <img 
                src={sugarImgUrl} 
                alt="Refined Sugar Manufacturing - Shakarganj Limited" 
                width="350"
                height="250"
                loading="lazy"
                onerror={`this.src='${sugarImgLocal}'`}
              />
              <span class="activity_badge">Core Segment</span>
            </div>
            <div class="activity_body">
              <div class="activity_title_row">
                <i class="fa fa-industry activity_title_icon"></i>
                <h4 class="activity_title">Sugar</h4>
              </div>
              <p class="activity_desc">
                Comprising pharmaceutical, beverage, commercial grades, soft brown, cubes, sachets and retail packs sugar.
              </p>
              <a href="/sugar" class="activity_btn">
                <span>Explore Segment</span> <i class="fa fa-arrow-right"></i>
              </a>
            </div>
          </div>

          <!-- Biofuel Card -->
          <div class="activity_card">
            <div class="activity_image_box">
              <img 
                src={biofuelImgUrl} 
                alt="Biofuels Distilleries - Shakarganj Limited" 
                width="350"
                height="250"
                loading="lazy"
                onerror={`this.src='${biofuelImgLocal}'`}
              />
              <span class="activity_badge renewable">Renewable Energy</span>
            </div>
            <div class="activity_body">
              <div class="activity_title_row">
                <i class="fa fa-flask activity_title_icon"></i>
                <h4 class="activity_title">Biofuels</h4>
              </div>
              <p class="activity_desc">
                We have distilleries located at Jhang and Bhone where various grades of biofuel are produced.
              </p>
              <a href="/biofuels" class="activity_btn">
                <span>Explore Segment</span> <i class="fa fa-arrow-right"></i>
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Page Hero Banner */
  .page_hero_banner {
    background: linear-gradient(135deg, #004d00 0%, #002b00 100%);
    color: #ffffff;
    padding: 55px 0 45px;
    border-bottom: 3px solid var(--primary-color);
  }
  .hero_breadcrumbs {
    font-size: 13px;
    color: #a0c8a0;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hero_breadcrumbs a {
    color: #a0c8a0;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .hero_breadcrumbs a:hover {
    color: #ffffff;
  }
  .hero_breadcrumbs .current {
    color: #ffffff;
    font-weight: 600;
  }
  .hero_page_title {
    font-size: 36px;
    font-family: var(--font-heading);
    font-weight: 700;
    margin-bottom: 10px;
    line-height: 1.2;
    color: #ffffff;
  }
  .hero_subtitle {
    font-size: 16px;
    color: #e0f0e0;
    max-width: 750px;
    line-height: 1.5;
    margin: 0;
  }

  /* Main Content Section */
  .profile_main_section {
    padding: 45px 0 65px 0;
    background: #f8fafc;
  }

  /* Executive Overview Card */
  .overview_card {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    padding: 32px;
    margin-bottom: 40px;
  }

  .overview_header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 2px solid #f1f5f9;
  }

  .overview_icon {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    background: rgba(22, 101, 52, 0.1);
    color: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
  }

  .overview_title {
    font-size: 22px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 4px 0;
  }

  .overview_tagline {
    font-size: 13px;
    font-weight: 600;
    color: var(--primary-color);
  }

  .overview_body {
    font-size: 15px;
    line-height: 1.8;
    color: #475569;
  }

  .overview_body p {
    margin: 0 0 16px 0;
  }

  .overview_body p:last-child {
    margin-bottom: 0;
  }

  /* Corporate Information Grid */
  .meta_section {
    margin-bottom: 45px;
  }

  .section_heading {
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 20px 0;
    position: relative;
    padding-left: 14px;
  }

  .section_heading::before {
    content: '';
    position: absolute;
    left: 0;
    top: 4px;
    bottom: 4px;
    width: 4px;
    background: var(--primary-color);
    border-radius: 2px;
  }

  .meta_grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .meta_card {
    background: #ffffff;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    transition: all 0.25s ease;
  }

  .meta_card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
    border-color: #cbd5e0;
  }

  .meta_icon {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: #f1f5f9;
    color: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .meta_info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .meta_label {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .meta_value {
    font-size: 15px;
    font-weight: 700;
    color: #1e293b;
  }

  .symbol_tag {
    color: var(--primary-color);
    font-size: 16px;
  }

  .meta_link {
    font-size: 14px;
    font-weight: 600;
    color: var(--primary-color);
    text-decoration: none;
  }

  .meta_link:hover {
    text-decoration: underline;
  }

  /* Business Activities Grid */
  .activities_header {
    margin-bottom: 24px;
  }

  .section_sub {
    font-size: 14px;
    color: #64748b;
    margin: 4px 0 0 14px;
  }

  .activities_grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .activity_card {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .activity_card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
    border-color: #cbd5e0;
  }

  .activity_image_box {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background: #0f172a;
  }

  .activity_image_box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .activity_card:hover .activity_image_box img {
    transform: scale(1.05);
  }

  .activity_badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(22, 101, 52, 0.9);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .activity_badge.renewable {
    background: rgba(30, 64, 175, 0.9);
  }

  .activity_body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .activity_title_row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .activity_title_icon {
    font-size: 18px;
    color: var(--primary-color);
  }

  .activity_title {
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
  }

  .activity_desc {
    font-size: 14px;
    line-height: 1.6;
    color: #475569;
    margin: 0 0 20px 0;
    flex-grow: 1;
  }

  .activity_btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 18px;
    background: #f1f5f9;
    color: #1e293b;
    border: 1px solid #cbd5e0;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
    width: fit-content;
  }

  .activity_btn:hover {
    background: var(--primary-color);
    color: #ffffff;
    border-color: var(--primary-color);
    box-shadow: 0 4px 12px rgba(22, 101, 52, 0.25);
  }

  /* Responsive Layout */
  @media (max-width: 992px) {
    .meta_grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .profile_hero {
      padding: 30px 0 40px 0;
    }

    .hero_title {
      font-size: 26px;
    }

    .meta_grid {
      grid-template-columns: 1fr;
    }

    .activities_grid {
      grid-template-columns: 1fr;
    }

    .overview_card {
      padding: 20px;
    }
  }
</style>
