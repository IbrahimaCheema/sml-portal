---
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import ExcellenceBanner from '../components/ExcellenceBanner.astro';
import InfoCards from '../components/InfoCards.astro';
import MottoStats from '../components/MottoStats.astro';
import StakeholderGrid from '../components/StakeholderGrid.astro';
import ProductSlider from '../components/ProductSlider.astro';
import NoticesGrid from '../components/NoticesGrid.astro';
import ComplaintSecp from '../components/ComplaintSecp.astro';
---

<Layout 
  title="Shakarganj Limited - SML | Premier Refined Sugar, Biofuels & Energy Group" 
  description="Shakarganj Limited (SML), incorporated in 1967, is Pakistan's premier industrial group specializing in high-grade refined sugar, bioethanol, renewable energy, and textiles."
  isHome={true}
>
  <!-- Hero Carousel -->
  <HeroSlider />

  <!-- 56 Years Banner -->
  <ExcellenceBanner />

  <!-- Business Divisions Info Cards -->
  <InfoCards />

  <!-- Motto & Animated Stats -->
  <MottoStats />

  <!-- Stakeholder Engagement Grid -->
  <StakeholderGrid />

  <!-- Product Slider / Showcase -->
  <ProductSlider />

  <!-- Notices & Updates Grid -->
  <NoticesGrid />

  <!-- SECP & Complaint Cell -->
  <ComplaintSecp />
</Layout>
