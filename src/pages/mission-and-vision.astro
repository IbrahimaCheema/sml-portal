---
import Layout from '../layouts/Layout.astro';

// Page Metadata
const pageTitle = "Mission and Vision | Shakarganj Limited";
const metaDescription = "Corporate Mission and Vision of Shakarganj Limited (SML). Committed to industry leadership, sustainable value creation, environmental stewardship, and social responsibility.";
---

<Layout title={pageTitle} description={metaDescription}>
  <!-- Modernized Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <i class="fa fa-angle-right"></i>
        <span>About Us</span> <i class="fa fa-angle-right"></i>
        <span class="current">Mission and Vision</span>
      </div>
      <h1 class="hero_page_title">Mission & Vision</h1>
      <p class="hero_subtitle">Guided by sustainable principles, operational excellence, and long-term value creation for all stakeholders.</p>
    </div>
  </section>

  <!-- Main Content Section -->
  <section class="mv_main_section">
    <div class="container">

      <!-- Vision Card -->
      <div class="vision_card">
        <div class="vision_content">
          <div class="vision_icon_box">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
            </svg>
          </div>
          <div class="vision_text_box">
            <h2 class="vision_heading">Our Vision</h2>
            <p class="vision_statement">
              "To excel across all our operations and deliver sustainable value to all stakeholders."
            </p>
          </div>
        </div>
      </div>

      <!-- Mission Section -->
      <div class="mission_container">
        <div class="section_header text-center">
          <span class="sub_title">Corporate Objectives</span>
          <h2 class="main_title">Our Mission</h2>
          <p class="header_desc">
            Seven core pillars driving our daily operations, strategic decision-making, and community engagement.
          </p>
        </div>

        <div class="mission_grid">
          
          <!-- Pillar 1 -->
          <div class="mission_card">
            <div class="card_header_row">
              <div class="pillar_icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
                  <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
                  <path d="M4 22h16"></path>
                  <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path>
                  <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path>
                  <path d="M18 2H6v7a6 6 0 0 0 12 0V2z"></path>
                </svg>
              </div>
              <span class="pillar_num">01</span>
            </div>
            <h3 class="pillar_title">Industry Leadership</h3>
            <p class="pillar_desc">
              To gain and maintain a leadership position in the industries we operate in by maintaining customer satisfaction, delivering quality products, committing to continuous process improvement and investing in technology, infrastructure and human resources.
            </p>
          </div>

          <!-- Pillar 2 -->
          <div class="mission_card">
            <div class="card_header_row">
              <div class="pillar_icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                  <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
              </div>
              <span class="pillar_num">02</span>
            </div>
            <h3 class="pillar_title">Shareholder Returns</h3>
            <p class="pillar_desc">
              To maximize returns to our shareholders by optimal allocation of resources by pursuing growth opportunities in high value markets and ensuring sustainable profitability.
            </p>
          </div>

          <!-- Pillar 3 -->
          <div class="mission_card">
            <div class="card_header_row">
              <div class="pillar_icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
              <span class="pillar_num">03</span>
            </div>
            <h3 class="pillar_title">Customer Value</h3>
            <p class="pillar_desc">
              To provide the best value products and services to our customers through investment in technology, infrastructure and human resources.
            </p>
          </div>

          <!-- Pillar 4 -->
          <div class="mission_card">
            <div class="card_header_row">
              <div class="pillar_icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <span class="pillar_num">04</span>
            </div>
            <h3 class="pillar_title">Strategic Partnerships</h3>
            <p class="pillar_desc">
              To work with our farmers, suppliers and distributors to develop long-term mutually beneficial partnerships.
            </p>
          </div>

          <!-- Pillar 5 -->
          <div class="mission_card">
            <div class="card_header_row">
              <div class="pillar_icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                </svg>
              </div>
              <span class="pillar_num">05</span>
            </div>
            <h3 class="pillar_title">Environmental Stewardship</h3>
            <p class="pillar_desc">
              To pursue environmentally friendly policies by effectively and efficiently using our energy resources, aiming for zero waste and a clean healthy environment in our community.
            </p>
          </div>

          <!-- Pillar 6 -->
          <div class="mission_card">
            <div class="card_header_row">
              <div class="pillar_icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                </svg>
              </div>
              <span class="pillar_num">06</span>
            </div>
            <h3 class="pillar_title">Social Responsibility</h3>
            <p class="pillar_desc">
              To be a socially responsible corporate citizen, supporting education, health, environment and socioeconomic development of our society.
            </p>
          </div>

          <!-- Pillar 7 -->
          <div class="mission_card highlight_card">
            <div class="card_header_row">
              <div class="pillar_icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <polyline points="16 11 18 13 22 9"></polyline>
                </svg>
              </div>
              <span class="pillar_num">07</span>
            </div>
            <h3 class="pillar_title">Workforce Empowerment</h3>
            <p class="pillar_desc">
              To provide the best working environment to our employees and provide them opportunities to enhance their skills.
            </p>
          </div>

        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Page Hero Banner */
  .page_hero_banner {
    background: linear-gradient(135deg, #004d00 0%, #002b00 100%);
    color: #ffffff;
    padding: 55px 0 45px;
    border-bottom: 3px solid var(--primary-color);
  }
  .hero_breadcrumbs {
    font-size: 13px;
    color: #a0c8a0;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hero_breadcrumbs a {
    color: #a0c8a0;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .hero_breadcrumbs a:hover {
    color: #ffffff;
  }
  .hero_breadcrumbs .current {
    color: #ffffff;
    font-weight: 600;
  }
  .hero_page_title {
    font-size: 36px;
    font-family: var(--font-heading);
    font-weight: 700;
    margin-bottom: 10px;
    line-height: 1.2;
    color: #ffffff;
  }
  .hero_subtitle {
    font-size: 16px;
    color: #e0f0e0;
    max-width: 750px;
    line-height: 1.5;
    margin: 0;
  }

  /* Main Section */
  .mv_main_section {
    padding: 45px 0 65px 0;
    background: #f8fafc;
  }

  /* Vision Card */
  .vision_card {
    background: linear-gradient(135deg, #1c3c28 0%, #166534 100%);
    border-radius: 14px;
    padding: 36px 40px;
    color: #ffffff;
    box-shadow: 0 10px 30px rgba(22, 101, 52, 0.25);
    margin-bottom: 50px;
    position: relative;
    overflow: hidden;
  }

  .vision_card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .vision_badge_strip {
    margin-bottom: 20px;
  }

  .vision_tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 14px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #81c784;
  }

  .vision_content {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .vision_icon_box {
    width: 68px;
    height: 68px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
    color: #ffffff;
    flex-shrink: 0;
  }

  .vision_text_box {
    flex-grow: 1;
  }

  .vision_heading {
    font-size: 24px;
    font-weight: 800;
    margin: 0 0 10px 0;
    color: #ffffff;
    letter-spacing: 0.5px;
  }

  .vision_statement {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.5;
    margin: 0;
    color: #f0fdf4;
    font-style: italic;
  }

  /* Mission Section */
  .section_header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 40px auto;
  }

  .sub_title {
    font-size: 12px;
    font-weight: 700;
    color: var(--primary-color);
    text-transform: uppercase;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 6px;
  }

  .main_title {
    font-size: 28px;
    font-weight: 800;
    color: #1e293b;
    margin: 0 0 10px 0;
  }

  .header_desc {
    font-size: 15px;
    color: #64748b;
    margin: 0;
  }

  /* Mission Grid */
  .mission_grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .mission_card {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    padding: 28px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .mission_card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
    border-color: #cbd5e0;
  }

  .card_header_row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }

  .pillar_icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: rgba(22, 101, 52, 0.08);
    color: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .pillar_num {
    font-size: 24px;
    font-weight: 800;
    color: #cbd5e0;
    font-family: inherit;
  }

  .pillar_title {
    font-size: 18px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 12px 0;
  }

  .pillar_desc {
    font-size: 14px;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  /* Responsive Grid */
  @media (max-width: 992px) {
    .mission_grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .mv_hero {
      padding: 30px 0 40px 0;
    }

    .hero_title {
      font-size: 26px;
    }

    .vision_card {
      padding: 24px;
    }

    .vision_content {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .vision_statement {
      font-size: 17px;
    }

    .mission_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
