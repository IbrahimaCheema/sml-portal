---
import Layout from '../layouts/Layout.astro';

// Page Metadata
const pageTitle = "Contact Us | Shakarganj Limited";
const metaDescription = "Contact Shakarganj Limited head office in Lahore, manufacturing complexes in Jhang and Bhone, and share registrar offices.";

// R2 Asset Image URLs
const imgLahoreOffice = "https://docs.sml.com.pk/images/contact_lahore_office.png";
const localLahoreOffice = "/images/contact_lahore_office.png";
const imgJhangFacility = "https://docs.sml.com.pk/images/contact_jhang_facility.jpg";
const localJhangFacility = "/images/contact_jhang_facility.jpg";
const imgBhoneFacility = "https://docs.sml.com.pk/images/contact_bhone_facility.jpg";
const localBhoneFacility = "/images/contact_bhone_facility.jpg";
const imgTextileFacility = "https://docs.sml.com.pk/images/contact_textile_facility.jpg";
const localTextileFacility = "/images/contact_textile_facility.jpg";

// Facility Locations Data
const facilities = [
  {
    id: "fac_lahore",
    name: "Registered & Principal Office",
    location: "Lahore Head Office",
    image: imgLahoreOffice,
    localImage: localLahoreOffice,
    address: "Executive Floor, IT Tower, 73 E 1, Hali Road, Gulberg III, Lahore, Pakistan",
    phone: "+92 42 111 111 765",
    fax: "+92 42 3578 3811",
    email: "info@shakarganj.pk",
    mapEmbed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d831.0882922013743!2d74.34089289200399!3d31.515512296072966!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x99b912765b95e5d3!2sShakarganj+Head+Office!5e0!3m2!1sen!2s!4v1518540161249"
  },
  {
    id: "fac_jhang",
    name: "Principal Facility",
    location: "Jhang Sugar & Biofuel Complex",
    image: imgJhangFacility,
    localImage: localJhangFacility,
    address: "Management House, Toba Road, Jhang, Punjab, Pakistan",
    phone: "+92 47 763 1001 - 06",
    fax: "+92 47 763 1011",
    email: "info@shakarganj.pk",
    mapEmbed: "https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d1014.2675312049017!2d72.33252274430119!3d31.2324819478497!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3923a322fdc45403%3A0xd7b9e59e78e91fd!2sShakarganj%20Limited%20(SML)%20I%20Jhang!5e0!3m2!1sen!2sus!4v1698037418015"
  },
  {
    id: "fac_bhone",
    name: "Satellite Facility",
    location: "Bhone Bio-Refinery",
    image: imgBhoneFacility,
    localImage: localBhoneFacility,
    address: "63km Jhang - Sargodha Road, Bhone, Punjab, Pakistan",
    phone: "+92 48 688 9210 - 12",
    fax: "+92 48 688 9211",
    email: "info@shakarganj.pk",
    mapEmbed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3391.8001770280293!2d72.2604704143261!3d31.775935581285797!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3923e1a19ead5aa5%3A0x62b67afe61aea3d7!2sShakarganj+(Bhone)!5e0!3m2!1sen!2s!4v1518590376840"
  },
  {
    id: "fac_faisalabad",
    name: "Faisalabad Office",
    location: "Nishatabad Office",
    image: imgLahoreOffice,
    localImage: localLahoreOffice,
    address: "Nishatabad, New Lahore Road, Faisalabad, Pakistan",
    phone: "+92 41 875 2810",
    fax: "+92 41 875 2811",
    email: "info@shakarganj.pk",
    mapEmbed: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13617.472719124408!2d73.090000!3d31.450000!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x392242b5ef861d85%3A0x7d6365b206cbbd3c!2sNishatabad%2C%20Faisalabad%2C%20Punjab!5e0!3m2!1sen!2spk!4v1698037600000"
  }
];
---

<Layout title={pageTitle} description={metaDescription}>
  <!-- Modernized Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <i class="fa fa-angle-right"></i>
        <span class="current">Contact Us</span>
      </div>
      <h1 class="hero_page_title">Contact Shakarganj Limited</h1>
      <p class="hero_subtitle">Get in touch with our corporate head office, manufacturing facilities, or customer support team.</p>
    </div>
  </section>

  <!-- Main Contact Section -->
  <section class="contact_main_section">
    <div class="container">
      
      <!-- Facility Locations Tab Navigation -->
      <div class="location_tabs_wrapper">
        <div class="section_intro text-center">
          <span class="sub_title">CORPORATE & OPERATIONAL LOCATIONS</span>
          <h2 class="main_title">Our Offices & Manufacturing Facilities</h2>
          <div class="heading_divider"></div>
        </div>

        <!-- Navigation Tabs -->
        <div class="location_tab_btns">
          {facilities.map((fac, idx) => (
            <button 
              class={`fac_tab_btn ${idx === 0 ? 'active' : ''}`} 
              data-fac={fac.id}
            >
              <span>{fac.name}</span>
            </button>
          ))}
        </div>

        <!-- Tab Content Panels with Google Maps Embeds -->
        {facilities.map((fac, idx) => (
          <div class={`fac_panel ${idx === 0 ? 'active' : ''}`} id={fac.id}>
            <div class="fac_panel_grid">
              
              <!-- Facility Details Column -->
              <div class="fac_info_col">
                <div class="fac_header">
                  <img 
                    src={fac.image} 
                    alt={fac.name} 
                    width="70"
                    height="70"
                    loading="lazy"
                    onerror={`this.src='${fac.localImage}'`}
                  />
                  <div>
                    <h3 class="fac_name">{fac.name}</h3>
                    <span class="fac_location">{fac.location}</span>
                  </div>
                </div>

                <div class="fac_contact_list">
                  <div class="contact_item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <div>
                      <strong>Address:</strong>
                      <p>{fac.address}</p>
                    </div>
                  </div>

                  <div class="contact_item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                    </svg>
                    <div>
                      <strong>Phone Number:</strong>
                      <p>{fac.phone}</p>
                    </div>
                  </div>

                  {fac.fax && (
                    <div class="contact_item">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                        <rect x="6" y="14" width="12" height="8"></rect>
                      </svg>
                      <div>
                        <strong>Fax Line:</strong>
                        <p>{fac.fax}</p>
                      </div>
                    </div>
                  )}

                  <div class="contact_item">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    <div>
                      <strong>Email Contact:</strong>
                      <p><a href={`mailto:${fac.email}`}>{fac.email}</a></p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Interactive Google Maps Frame Column -->
              <div class="fac_map_col">
                <div class="map_frame">
                  <iframe 
                    src={fac.mapEmbed} 
                    width="100%" 
                    height="340" 
                    style="border:0;" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade"
                    title={`Google Map Location for ${fac.name}`}
                  ></iframe>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>

      <!-- General Inquiry Form Section -->
      <div class="inquiry_form_section">
        <div class="inquiry_card">
          <div class="form_header text-center">
            <span class="sub_title">SEND US A MESSAGE</span>
            <h2 class="main_title">General Contact & Feedback Form</h2>
            <p class="form_desc">Have a question regarding our products, investor relations, or services? Fill out the form below and our team will get back to you shortly.</p>
          </div>

          <form id="contactForm" class="contact_form">
            <div class="form_row">
              <div class="form_group">
                <label for="cName">Full Name <span class="req">*</span></label>
                <input type="text" id="cName" name="cName" placeholder="e.g. Muhammad Ali" required />
              </div>
              <div class="form_group">
                <label for="cEmail">Email Address <span class="req">*</span></label>
                <input type="email" id="cEmail" name="cEmail" placeholder="e.g. ali@example.com" required />
              </div>
            </div>

            <div class="form_row">
              <div class="form_group">
                <label for="cPhone">Phone Number <span class="req">*</span></label>
                <input type="tel" id="cPhone" name="cPhone" placeholder="e.g. +92 300 1234567" required />
              </div>
              <div class="form_group">
                <label for="cDepartment">Department / Inquiry Area <span class="req">*</span></label>
                <select id="cDepartment" name="cDepartment" required>
                  <option value="" disabled selected>Select Department</option>
                  <option value="General Corporate Inquiry">General Corporate Inquiry</option>
                  <option value="Sugar Sales & Distribution">Sugar Sales & Distribution</option>
                  <option value="Biofuels & Ethanol Exports">Biofuels & Ethanol Exports</option>
                  <option value="Investor & Shareholder Relations">Investor & Shareholder Relations</option>
                  <option value="Careers & HR Department">Careers & HR Department</option>
                </select>
              </div>
            </div>

            <div class="form_group">
              <label for="cSubject">Subject / Topic <span class="req">*</span></label>
              <input type="text" id="cSubject" name="cSubject" placeholder="e.g. Inquiry regarding refined sugar supply" required />
            </div>

            <div class="form_group">
              <label for="cMessage">Your Message / Requirements <span class="req">*</span></label>
              <textarea id="cMessage" name="cMessage" rows="4" placeholder="Type your message here..." required></textarea>
            </div>

            <div class="text-center">
              <button type="submit" class="submit_btn" id="cSubmitBtn">
                <span>Send Message to Shakarganj</span>
                <i class="fa fa-paper-plane"></i>
              </button>
            </div>

            <div class="form_alert" id="cFormAlert" style="display: none;"></div>
          </form>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Facility Tab Switching
    const tabBtns = document.querySelectorAll('.fac_tab_btn');
    const panels = document.querySelectorAll('.fac_panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-fac');

        tabBtns.forEach(b => b.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));

        btn.classList.add('active');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) targetPanel.classList.add('active');
      });
    });

    // Contact Form Submission Simulation
    const form = document.getElementById('contactForm');
    const alertBox = document.getElementById('cFormAlert');
    const submitBtn = document.getElementById('cSubmitBtn');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>Sending Message...</span> <i class="fa fa-spinner fa-spin"></i>';
        }

        setTimeout(() => {
          if (alertBox) {
            alertBox.className = 'form_alert success';
            alertBox.style.display = 'block';
            alertBox.innerHTML = '<i class="fa fa-check-circle"></i> Thank you! Your inquiry has been sent successfully. Our team will contact you within 24 business hours.';
          }

          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Message Sent Successfully</span> <i class="fa fa-check"></i>';
          }

          form.reset();
        }, 1200);
      });
    }
  });
</script>

<style>
  /* Page Hero Banner */
  .page_hero_banner {
    background: linear-gradient(135deg, #004d00 0%, #002b00 100%);
    color: #ffffff;
    padding: 55px 0 45px;
    border-bottom: 3px solid var(--primary-color);
  }
  .hero_breadcrumbs {
    font-size: 13px;
    color: #a0c8a0;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hero_breadcrumbs a {
    color: #a0c8a0;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .hero_breadcrumbs a:hover {
    color: #ffffff;
  }
  .hero_breadcrumbs .current {
    color: #ffffff;
    font-weight: 600;
  }
  .hero_page_title {
    font-size: 36px;
    font-family: var(--font-heading);
    font-weight: 700;
    margin-bottom: 10px;
    line-height: 1.2;
    color: #ffffff;
  }
  .hero_subtitle {
    font-size: 16px;
    color: #e0f0e0;
    max-width: 750px;
    line-height: 1.5;
    margin: 0;
  }

  /* Main Contact Section */
  .contact_main_section {
    padding: 60px 0 80px 0;
    background: #f8fafc;
  }

  .section_intro {
    margin-bottom: 30px;
  }

  .sub_title {
    font-size: 12px;
    font-weight: 700;
    color: var(--primary-color);
    text-transform: uppercase;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 6px;
  }

  .main_title {
    font-size: 28px;
    font-weight: 800;
    color: #1e293b;
    margin: 0 0 10px 0;
  }

  .heading_divider {
    width: 60px;
    height: 3px;
    background: var(--primary-color);
    margin: 0 auto;
    border-radius: 2px;
  }

  /* Facility Location Tabs */
  .location_tabs_wrapper {
    margin-bottom: 65px;
  }

  .location_tab_btns {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
  }

  .fac_tab_btn {
    padding: 12px 20px;
    background: #ffffff;
    border: 1px solid #cbd5e0;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.25s ease;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
  }

  .fac_tab_btn:hover {
    border-color: var(--primary-color);
    color: var(--primary-color);
  }

  .fac_tab_btn.active {
    background: var(--primary-color);
    color: #ffffff;
    border-color: var(--primary-color);
    box-shadow: 0 4px 12px rgba(22, 101, 52, 0.2);
  }

  /* Facility Panel Grid */
  .fac_panel {
    display: none;
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .fac_panel.active {
    display: block;
    animation: fadeIn 0.35s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .fac_panel_grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 32px;
    align-items: center;
  }

  .fac_header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid #f1f5f9;
  }

  .fac_header img {
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--primary-color);
  }

  .fac_name {
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 4px 0;
  }

  .fac_location {
    font-size: 13px;
    font-weight: 600;
    color: var(--primary-color);
  }

  .fac_contact_list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact_item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .contact_item svg {
    margin-top: 2px;
    flex-shrink: 0;
  }

  .contact_item strong {
    display: block;
    font-size: 12.5px;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 2px;
  }

  .contact_item p {
    font-size: 14px;
    color: #1e293b;
    margin: 0;
    line-height: 1.5;
  }

  .contact_item a {
    color: var(--primary-color);
    text-decoration: underline;
  }

  .map_frame {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    border: 1px solid #cbd5e0;
  }

  /* Inquiry Form Section */
  .inquiry_form_section {
    max-width: 900px;
    margin: 0 auto;
  }

  .inquiry_card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    padding: 40px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .form_header {
    margin-bottom: 30px;
  }

  .form_desc {
    font-size: 14.5px;
    color: #64748b;
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .contact_form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form_row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .form_group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form_group label {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
  }

  .req {
    color: #dc2626;
  }

  .form_group input[type="text"],
  .form_group input[type="email"],
  .form_group input[type="tel"],
  .form_group select,
  .form_group textarea {
    padding: 11px 14px;
    border-radius: 8px;
    border: 1px solid #cbd5e0;
    font-size: 14px;
    color: #1e293b;
    background: #ffffff;
    transition: all 0.25s ease;
  }

  .form_group input:focus,
  .form_group select:focus,
  .form_group textarea:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(22, 101, 52, 0.15);
  }

  .submit_btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 32px;
    background: var(--primary-color);
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.25s ease;
    margin-top: 10px;
  }

  .submit_btn:hover {
    background: #14532d;
  }

  .form_alert.success {
    padding: 14px 18px;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.5;
    margin-top: 16px;
  }

  /* Responsive Design */
  @media (max-width: 992px) {
    .fac_panel_grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .form_row {
      grid-template-columns: 1fr;
    }
    .location_tab_btns {
      flex-direction: column;
    }
    .fac_tab_btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
