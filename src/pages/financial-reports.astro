    color: #a0c8a0;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hero_breadcrumbs a {
    color: #a0c8a0;
  }
  .hero_breadcrumbs a:hover {
    color: #ffffff;
  }
  .hero_breadcrumbs .current {
    color: #ffffff;
    font-weight: 600;
  }
  .hero_page_title {
    font-size: 36px;
    font-family: var(--font-heading);
    font-weight: 700;
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .hero_subtitle {
    font-size: 16px;
    color: #e0f0e0;
    max-width: 800px;
    line-height: 1.5;
    margin-bottom: 25px;
  }

  /* Metrics Ribbon */
  .metrics_ribbon {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 16px 24px;
    border-radius: 10px;
    max-width: 800px;
  }
  .metric_item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .metric_item i {
    font-size: 22px;
    color: #4ade80;
  }
  .metric_item strong {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #a0c8a0;
  }
  .metric_item span {
    font-size: 14px;
    font-weight: 600;
    color: #ffffff;
  }

  /* Main Financial Section */
  .financial_section {
    padding: 60px 0 80px;
    background-color: #f8faf8;
  }

  /* Year Tabs Navigation */
  .year_tabs_container {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 40px;
    flex-wrap: wrap;
    background: #ffffff;
    padding: 16px 24px;
    border-radius: 12px;
    border: 1px solid #e5e9e5;
    box-shadow: 0 4px 15px rgba(0,0,0,0.03);
  }
  .tabs_label {
    font-size: 15px;
    font-weight: 700;
    color: #222222;
    font-family: var(--font-heading);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tabs_label i {
    color: var(--primary-color);
  }

  .year_tabs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .year_tab_btn {
    background: #f0f4f0;
    color: #444444;
    border: 1px solid #e0e6e0;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    font-family: var(--font-heading);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.3s ease;
  }
  .year_tab_btn:hover {
    background: var(--primary-color);
    color: #ffffff;
    border-color: var(--primary-color);
  }
  .year_tab_btn.active {
    background: var(--primary-color);
    color: #ffffff;
    border-color: var(--primary-color);
    box-shadow: 0 4px 12px rgba(0, 80, 0, 0.25);
  }
  .historical_btn {
    background: linear-gradient(135deg, #181b1e 0%, #2c353d 100%) !important;
    color: #ffb800 !important;
    border: 1px solid rgba(255, 184, 0, 0.5) !important;
    text-decoration: none;
  }
  .historical_btn:hover {
