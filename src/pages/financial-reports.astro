<Layout title="Financial Reports - Shakarganj Limited">
  <!-- Page Hero Banner -->
  <section class="page_hero_banner">
    <div class="container">
      <div class="hero_breadcrumbs">
        <a href="/">Home</a> <i class="fa fa-angle-right"></i>
        <span>Investor Relations</span> <i class="fa fa-angle-right"></i>
        <span class="current">Financial Reports</span>
      </div>
      <h1 class="hero_page_title">Financial Reports</h1>
      <p class="hero_subtitle">Audited annual financial statements, half-yearly reviews, and quarterly reports for Shakarganj Limited investors (10 Years Archive: 2017 – 2026).</p>
      
      <!-- Key Financial Metrics Ribbon -->
      <div class="metrics_ribbon">
        <div class="metric_item">
          <i class="fa fa-line-chart"></i>
          <div>
            <strong>PSX Symbol</strong>
            <span>SML (Sugar & Allied)</span>
          </div>
        </div>
        <div class="metric_item">
          <i class="fa fa-calendar-check-o"></i>
          <div>
            <strong>Fiscal Year End</strong>
            <span>September 30</span>
          </div>
        </div>
        <div class="metric_item">
          <i class="fa fa-file-pdf-o"></i>
          <div>
            <strong>Latest Report</strong>
            <span>Half Year March 2026</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Financial Reports Section -->
  <section class="financial_section">
    <div class="container">

      <!-- Year Pill Navigation Tabs -->
      <div class="year_tabs_container">
        <span class="tabs_label"><i class="fa fa-filter"></i> Select Year:</span>
        <div class="year_tabs">
          {reportsData.map((yData, idx) => (
            <button 
              class={`year_tab_btn ${idx === 0 ? 'active' : ''}`}
              data-year={yData.year}
            >
              <i class="fa fa-folder"></i> {yData.year}
            </button>
          ))}
          <a href="/historical-reports" class="year_tab_btn historical_btn">
            <i class="fa fa-history"></i> Historical Reports (1979–2016)
          </a>
        </div>
      </div>

      <!-- Year Content Panels -->
      <div class="year_panels_container">
        {reportsData.map((yData, idx) => (
          <div 
            class={`year_panel ${idx === 0 ? 'active' : ''}`}
            id={`panel_${yData.year}`}
          >
            <div class="panel_header">
              <h2><i class="fa fa-calendar"></i> FY {yData.year} Reports</h2>
              <span class="reports_count_badge">{yData.reports.length} Reports Published</span>
            </div>

            <div class="reports_grid">
              {yData.reports.map((rep) => (
                <div class="report_card">
                  <div class="card_thumb_wrapper">
                    <span class="pdf_tag"><i class="fa fa-file-pdf-o"></i> PDF</span>
                    <img src={rep.thumb} alt={rep.title} loading="lazy" />
                    <div class="thumb_overlay">
                      <a href={rep.pdf} target="_blank" class="overlay_view_btn">
                        <i class="fa fa-eye"></i> Quick View
                      </a>
                    </div>
                  </div>

                  <div class="card_details">
                    <div class="card_meta">
                      <span class="quarter_badge" style={`background-color: ${rep.badgeColor};`}>
                        {rep.quarter}
                      </span>
                      <span class="period_text"><i class="fa fa-clock-o"></i> {rep.period}</span>
                    </div>

                    <h3 class="report_title">{rep.title}</h3>

                    <div class="card_actions">
                      <a href={rep.pdf} target="_blank" class="download_btn">
                        <i class="fa fa-file-pdf-o"></i> Download PDF
                      </a>
                      <a href={rep.pdf} target="_blank" class="open_btn" title="Open PDF in new tab">
                        <i class="fa fa-external-link"></i>
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.year_tab_btn');
    const panels = document.querySelectorAll('.year_panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const year = btn.getAttribute('data-year');

        // Toggle active button
        tabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Toggle active panel
        panels.forEach(p => {
          if (p.id === `panel_${year}`) {
            p.classList.add('active');
          } else {
            p.classList.remove('active');
          }
        });
      });
    });
  });
</script>

<style>
