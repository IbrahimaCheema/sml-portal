        ["Gender Pay Gap Statement (Circular 10 of 2024)", "جینڈر پے گیپ اسٹیٹمنٹ (سرکولر 10 آف 2024ء)"],
        ["Unclaimed Dividend Details 2023", "غیر دعویٰ شدہ ڈیویڈنڈ کی تفصیلات 2023ء"],

        // ==========================================
        // 9. GENERAL CONTACT & ACTIONS
        // ==========================================
        ["Get in Touch", "رابطہ کیجیے"],
        ["Head Office", "ہیڈ آفس"],
        ["Registered Office", "رجسٹرڈ آفس"],
        ["Send Message", "پیغام بھیجیں"],
        ["Your Name", "آپ کا نام"],
        ["Email Address", "ای میل ایڈریس"],
        ["Phone Number", "فون نمبر"],
        ["Subject", "موضوع"],
        ["Message", "پیغام"],
        ["Apply Now", "درخواست دیں"]
      ];

      // Pre-sort dictionary descending by English phrase length
      // Ensures long compound phrases match BEFORE shorter substrings!
      const sortedTranslations = [...rawTranslationList].sort((a, b) => b[0].length - a[0].length);

      // Fast-path exact match Map
      const exactTranslationMap = new Map();
      for (const [en, ur] of sortedTranslations) {
        exactTranslationMap.set(en.trim(), ur);
      }

      function escapeRegex(str) {
        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      }

      function translateText(val) {
        if (!val || !val.trim()) return val;
        const trimmed = val.trim();

        // 1. Exact match fast path
        if (exactTranslationMap.has(trimmed)) {
          const lead = val.match(/^\s*/)[0];
          const trail = val.match(/\s*$/)[0];
          return lead + exactTranslationMap.get(trimmed) + trail;
        }

        // 2. Phrase replacements in length-descending order
        let result = val;
        for (let i = 0; i < sortedTranslations.length; i++) {
          const en = sortedTranslations[i][0];
          const ur = sortedTranslations[i][1];
          if (result.includes(en)) {
            result = result.replace(new RegExp(escapeRegex(en), 'g'), ur);
          }
        }
        return result;
      }

      // Recursive Text Node Walker that translates all text nodes and input placeholders
      function translateDOMNode(node, lang) {
        if (node.nodeType === Node.TEXT_NODE) {
          const raw = node.nodeValue;
          if (!raw || !raw.trim()) return;

          if (!node._origValue) {
            node._origValue = raw;
          }

          if (lang === 'ur') {
            node.nodeValue = translateText(node._origValue);
          } else {
            node.nodeValue = node._origValue;
          }
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const tag = node.tagName;
          if (tag === 'SCRIPT' || tag === 'STYLE' || node.id === 'live_results_dropdown' || node.id === 'footer_live_dropdown') {
            return;
          }

          // Handle input & textarea placeholders
          if (tag === 'INPUT' || tag === 'TEXTAREA') {
            if (node.placeholder) {
              if (!node._origPlaceholder) {
                node._origPlaceholder = node.placeholder;
              }
              if (lang === 'ur') {
                node.placeholder = translateText(node._origPlaceholder);
                node.setAttribute('dir', 'rtl');
              } else {
                node.placeholder = node._origPlaceholder;
                node.setAttribute('dir', 'ltr');
              }
            }
            return;
          }

          for (let i = 0; i < node.childNodes.length; i++) {
            translateDOMNode(node.childNodes[i], lang);
          }
        }
      }

      function applyLanguage(lang) {
        const html = document.documentElement;
        if (lang === 'ur') {
          html.setAttribute('lang', 'ur');
          html.setAttribute('dir', 'rtl');
        } else {
          html.setAttribute('lang', 'en-US');
          html.setAttribute('dir', 'ltr');
        }

        // Run deep text node walker across entire body
        translateDOMNode(document.body, lang);

        // Sync dropdown selectors
        const langDropdowns = document.querySelectorAll('#lang_select, .lang_dropdown');
        langDropdowns.forEach(select => {
          select.value = lang;
        });

        localStorage.setItem('sml_lang', lang);
      }

      window.applyCurrentLanguage = function() {
        const savedLang = localStorage.getItem('sml_lang') || 'en';
        applyLanguage(savedLang);
      };

      // Initialize language on DOM Ready
      document.addEventListener('DOMContentLoaded', () => {
        const savedLang = localStorage.getItem('sml_lang') || 'en';
        if (savedLang === 'ur') {
          applyLanguage('ur');
        }

        document.addEventListener('change', (e) => {
          if (e.target && (e.target.id === 'lang_select' || e.target.classList.contains('lang_dropdown'))) {
            applyLanguage(e.target.value);
          }
        });
      });

      // Scroll to Top
      const scrollBtn = document.getElementById('scroll-to-top');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          if (scrollBtn) scrollBtn.style.display = 'flex';
        } else {
          if (scrollBtn) scrollBtn.style.display = 'none';
        }
      });
      scrollBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>
