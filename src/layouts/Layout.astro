---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Shakarganj Limited - SML",
  description = "Shakarganj Limited, incorporated in 1967, is listed on the Pakistan Stock Exchange. Market leader in refined sugar and biofuels."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="https://docs.sml.com.pk/images/favicon.png" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" integrity="sha512-SfTiTlX6kk+qitfevl/7LibUOeJWlt9rbyDn92a1DqWOw9vWG2MFoays0sgObmWazO5BDEL+Zxd8J6em8IBXw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>
  <body>
    <div id="wrapper">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <!-- Scroll to Top Button -->
    <button id="scroll-to-top" aria-label="Scroll to top">
      <i class="fa fa-chevron-up"></i>
    </button>

    <style is:global>
      /* Jameel Noori Nastaleeq Font Definition */
      @font-face {
        font-family: 'Jameel Noori Nastaleeq';
        src: url('/fonts/JameelNooriNastaleeq.woff') format('woff'),
             url('https://docs.sml.com.pk/fonts/JameelNooriNastaleeq.woff') format('woff'),
             url('https://cdn.jsdelivr.net/gh/tariq-abdullah/urdu-web-font-CDN/JameelNooriNastaleeq.woff') format('woff');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      /* Unified Approved Jameel Noori Nastaleeq Font Style for Urdu Across the Entire Board */
      html[lang="ur"],
      html[dir="rtl"],
      html[lang="ur"] body, html[lang="ur"] h1, html[lang="ur"] h2, html[lang="ur"] h3, html[lang="ur"] h4, html[lang="ur"] h5, html[lang="ur"] h6,
      html[lang="ur"] p, html[lang="ur"] a, html[lang="ur"] span, html[lang="ur"] button, html[lang="ur"] div,
      html[lang="ur"] li, html[lang="ur"] input, html[lang="ur"] select, html[lang="ur"] strong, html[lang="ur"] b, html[lang="ur"] mark,
      html[dir="rtl"] body, html[dir="rtl"] h1, html[dir="rtl"] h2, html[dir="rtl"] h3, html[dir="rtl"] h4, html[dir="rtl"] h5, html[dir="rtl"] h6,
      html[dir="rtl"] p, html[dir="rtl"] a, html[dir="rtl"] span, html[dir="rtl"] button, html[dir="rtl"] div,
      html[dir="rtl"] li, html[dir="rtl"] input, html[dir="rtl"] select, html[dir="rtl"] strong, html[dir="rtl"] b, html[dir="rtl"] mark {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', 'Poppins', serif !important;
      }

      html[lang="ur"] body,
      html[dir="rtl"] body {
        direction: rtl !important;
        text-align: right !important;
        line-height: 1.9 !important;
      }
      html[dir="rtl"] h1, html[dir="rtl"] h2, html[dir="rtl"] h3, html[dir="rtl"] h4 {
        line-height: 1.8 !important;
        padding-top: 4px;
        padding-bottom: 4px;
      }
      html[dir="rtl"] p {
        line-height: 2.0 !important;
      }
      html[dir="rtl"] .top_bar_right {
        direction: ltr;
      }
      html[dir="rtl"] .main_menu {
        direction: rtl;
      }
      html[dir="rtl"] .main_menu > li > a {
        font-family: 'Jameel Noori Nastaleeq', serif !important;
        font-size: 18px !important;
        line-height: 1.8 !important;
      }
      html[dir="rtl"] .footer_grid {
        direction: rtl;
      }
      html[dir="rtl"] .copyright_flex {
        direction: rtl;
      }
      html[dir="rtl"] .read_more, html[dir="rtl"] .result_link {
        font-family: 'Jameel Noori Nastaleeq', serif !important;
        font-size: 16px !important;
      }
      html[dir="rtl"] .read_more i,
      html[dir="rtl"] .result_link i {
        transform: rotate(180deg);
        display: inline-block;
      }

      #scroll-to-top {
        position: fixed;
        bottom: 25px;
        right: 25px;
        width: 42px;
        height: 42px;
        background-color: var(--primary-color);
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        display: none;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        z-index: 999;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
      }
      #scroll-to-top:hover {
        background-color: #222;
      }
    </style>

    <!-- Recursive Deep Text Node Urdu Translation Engine -->
