---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const { 
  title = "Shakarganj Limited - SML",
  description = "Shakarganj Limited, incorporated in 1967, is listed on the Pakistan Stock Exchange. Market leader in refined sugar and biofuels.",
  isHome
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="https://docs.sml.com.pk/images/favicon.png" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" integrity="sha512-SfTiTlX6kk+qitfevl/7LibUOeJWlt9rbyDn92a1DqWOw9vWG2MFoays0sgObmWazO5BDEL+Zxd8J6em8IBXw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>
  <body>
    <div id="wrapper">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer isHome={isHome} />
    </div>

    <!-- Floating Corporate Social Media Dock -->
    <div class="floating_social_dock" aria-label="Official Social Media Pages">
      <a href="https://www.facebook.com/ShakarganjLimited" target="_blank" rel="noopener noreferrer" class="dock_btn fb" aria-label="Facebook" title="Shakarganj Facebook Page">
        <svg class="social_svg fb_svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        <span class="dock_label">Facebook</span>
      </a>
      <a href="https://www.linkedin.com/company/shakarganj-limited" target="_blank" rel="noopener noreferrer" class="dock_btn li" aria-label="LinkedIn" title="Shakarganj LinkedIn Page">
        <svg class="social_svg li_svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
        <span class="dock_label">LinkedIn</span>
      </a>
    </div>

    <!-- Scroll to Top Button -->
    <button id="scroll-to-top" aria-label="Scroll to top">
      <i class="fa fa-chevron-up"></i>
    </button>

    <style is:global>
      /* Jameel Noori Nastaleeq Font Definition */
      @font-face {
        font-family: 'Jameel Noori Nastaleeq';
        src: url('/fonts/JameelNooriNastaleeq.woff') format('woff'),
             url('https://docs.sml.com.pk/fonts/JameelNooriNastaleeq.woff') format('woff'),
             url('https://cdn.jsdelivr.net/gh/tariq-abdullah/urdu-web-font-CDN/JameelNooriNastaleeq.woff') format('woff');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      /* Unified Approved Jameel Noori Nastaleeq Font Style for Urdu Across the Entire Board */
      html[lang="ur"],
      html[dir="rtl"],
      html[lang="ur"] body, html[lang="ur"] h1, html[lang="ur"] h2, html[lang="ur"] h3, html[lang="ur"] h4, html[lang="ur"] h5, html[lang="ur"] h6,
      html[lang="ur"] p, html[lang="ur"] a, html[lang="ur"] span, html[lang="ur"] button, html[lang="ur"] div,
      html[lang="ur"] li, html[lang="ur"] input, html[lang="ur"] select, html[lang="ur"] strong, html[lang="ur"] b, html[lang="ur"] mark,
      html[dir="rtl"] body, html[dir="rtl"] h1, html[dir="rtl"] h2, html[dir="rtl"] h3, html[dir="rtl"] h4, html[dir="rtl"] h5, html[dir="rtl"] h6,
      html[dir="rtl"] p, html[dir="rtl"] a, html[dir="rtl"] span, html[dir="rtl"] button, html[dir="rtl"] div,
      html[dir="rtl"] li, html[dir="rtl"] input, html[dir="rtl"] select, html[dir="rtl"] strong, html[dir="rtl"] b, html[dir="rtl"] mark {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', 'Poppins', serif !important;
      }

      html[lang="ur"] body,
      html[dir="rtl"] body {
        direction: rtl !important;
        text-align: right !important;
        line-height: 1.9 !important;
      }
      html[dir="rtl"] h1, html[dir="rtl"] h2, html[dir="rtl"] h3, html[dir="rtl"] h4 {
        line-height: 1.8 !important;
        padding-top: 4px;
        padding-bottom: 4px;
      }
      html[dir="rtl"] p {
        line-height: 2.0 !important;
      }
      html[dir="rtl"] .top_bar_right {
        direction: ltr;
      }
      html[dir="rtl"] .main_menu {
        direction: rtl;
      }
      html[dir="rtl"] .main_menu > li > a {
        font-family: 'Jameel Noori Nastaleeq', serif !important;
        font-size: 18px !important;
        line-height: 1.8 !important;
      }
      html[dir="rtl"] .footer_grid {
        direction: rtl;
      }
      html[dir="rtl"] .copyright_flex {
        direction: rtl;
      }
      html[dir="rtl"] .read_more, html[dir="rtl"] .result_link {
        font-family: 'Jameel Noori Nastaleeq', serif !important;
        font-size: 16px !important;
      }
      html[dir="rtl"] .read_more i,
      html[dir="rtl"] .result_link i {
        transform: rotate(180deg);
        display: inline-block;
      }

      #scroll-to-top {
        position: fixed;
        bottom: 25px;
        right: 25px;
        width: 42px;
        height: 42px;
        background-color: var(--primary-color);
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        display: none;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        z-index: 999;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
      }
      #scroll-to-top:hover {
        background-color: #222;
      }

      @media (max-width: 768px) {
        #scroll-to-top {
          bottom: 15px;
          right: 15px;
          width: 36px;
          height: 36px;
          font-size: 14px;
          opacity: 0.85;
        }
      }
    </style>

    <!-- Recursive Deep Text Node Urdu Translation Engine -->
    <script is:inline>
      const translationList = [
        // Financial Reports Page
        ["Financial Reports & Annual Statements", "مالیاتی رپورٹس اور سالانہ گوشوارے"],
        ["Financial Reports", "مالیاتی رپورٹس"],
        ["Financial Statements", "مالیاتی گوشوارے"],
        ["Audited annual financial statements, half-yearly reviews, and quarterly reports for Shakarganj Limited investors (Last 5 Years: 2022 – 2026).", "شکر گنج لمیٹڈ کے سرمایہ کاروں کے لیے سالانہ آڈٹ شدہ مالیاتی گوشوارے، ششماہی اور سہ ماہی رپورٹس (گزشتہ 5 سال: 2022ء – 2026ء)۔"],
        ["Fiscal Year End", "مالیاتی سال کا اختتام"],
        ["Latest Report", "تازہ ترین رپورٹ"],
        ["Select Year:", "سال منتخب کریں:"],
        ["Reports Published", "رپورٹس شائع شدہ"],
        ["Annual Report", "سالانہ رپورٹ"],
        ["Q2 - Half Yearly", "Q2 - ششماہی رپورٹ"],
        ["Q1 - First Quarter", "Q1 - پہلی سہ ماہی"],
        ["Q3 - Third Quarter", "Q3 - تیسری سہ ماہی"],
        ["Download PDF", "پی ڈی ایف ڈاؤن لوڈ کریں"],
        ["Quick View", "فوری جائزہ"],

        // Shareholder's Information Page
        ["Shareholder's Information", "شیئر ہولڈر کی معلومات"],
        ["Share Registrar", "شیئر رجسٹرار"],
        ["Company Secretary", "کمپنی سیکرٹری"],
        ["Stock Exchange Listing", "اسٹاک ایکسچینج لسٹنگ"],
        ["Election of Directors (01 June 2026)", "بورڈ آف ڈائریکٹرز کا انتخاب (01 جون 2026ء)"],
        ["Election of Directors Results 2026", "ڈائریکٹرز کے انتخاب کے نتائج 2026ء"],
        ["Report of Scrutinizer 2026", "اسکروٹنائزر کی رپورٹ 2026ء"],
        ["Corporate Governance Policies & Statements", "کارپوریٹ گورننس پالیسیاں اور بیانات"],
        ["SECP Investor Complaint Section", "ایس ای سی پی انویسٹر شکایات سیل"],
        ["Corporate Auditors & Advisors", "کارپوریٹ آڈیٹرز اور قانونی مشیر"],
        ["Code of Conduct", "ضابطہ اخلاق"],
        ["Policies Register", "پالیسیز رجسٹر"],
        ["Website Compliance Certificate (Sep 2025)", "ویب سائٹ کمپلائنس سرٹیفکیٹ (ستمبر 2025ء)"],
        ["Gender Pay Gap Statement (Circular 10 of 2024)", "جینڈر پے گیپ اسٹیٹمنٹ (سرکولر 10 آف 2024ء)"],
        ["Unclaimed Dividend Details 2023", "غیر دعویٰ شدہ ڈیویڈنڈ کی تفصیلات 2023ء"],

        // Board of Directors & Committees Titles
        ["Profile of Board of Directors & Management", "بورڈ آف ڈائریکٹرز اور انتظامیہ کا پروفائل"],
        ["Profile of Board of Directors", "بورڈ آف ڈائریکٹرز کا پروفائل"],
        ["Guiding Shakarganj Limited with integrity, strategic vision, and corporate governance excellence.", "دیانتداری، اسٹریٹجک بصیرت، اور گورننس کی اعلیٰ ترین روایت کے ساتھ شکر گنج لمیٹڈ کی رہنمائی۔"],
        ["HR, Remuneration and Nomination Committee", "ایچ آر، ریمونریشن اور نامزدگی کمیٹی"],
        ["HR & Remuneration", "ایچ آر اور ریمونریشن"],
        ["Risk Management Committee of the Board", "بورڈ کی رسک مینجمنٹ کمیٹی"],
        ["Risk Management", "رسک مینجمنٹ"],
        ["Audit Committee", "آڈٹ کمیٹی"],
        ["Board of Directors", "بورڈ آف ڈائریکٹرز"],
        ["The Management", "انتظامیہ (دی مینجمنٹ)"],
        ["Management Committees", "مینجمنٹ کمیٹیاں"],
        ["Executive Committee", "ایگزیکٹو کمیٹی"],
        ["Business Strategy Committee", "بزنس اسٹریٹجی کمیٹی"],
        ["System & Technology Committee", "سسٹم اینڈ ٹیکنالوجی کمیٹی"],

        // Roles & Badges
        ["Chief Executive Officer", "چیف ایگزیکٹو آفیسر"],
        ["Deputy Chief Executive Officer", "ڈپٹی چیف ایگزیکٹو آفیسر"],
        ["Chief Financial Officer", "چیف فنانشل آفیسر"],
        ["Chief Information Officer", "چیف انفارمیشن آفیسر"],
        ["Vice President (Operations)", "وائس پریذیڈنٹ (آپریشنز)"],
        ["Non-Executive Director", "نان ایگزیکٹو ڈائریکٹر"],
        ["Executive Director", "ایگزیکٹو ڈائریکٹر"],
        ["Independent Director", "انڈیپنڈنٹ ڈائریکٹر"],
        ["Chairperson", "چیئرپرسن"],
        ["Chairman", "چیئرمین"],
        ["Member", "رکن"],
        ["Joined Board:", "بورڈ میں شمولیت:"],
        ["Address:", "پتہ:"],
        ["Other Engagements:", "دیگر وابستگی:"],

        // Hero Slider Words & Phrases
        ["Building Value", "قدر کی تعمیر"],
        ["Strengthening Communities.", "کمیونٹیز کا استحکام"],
        ["Strengthening Communities", "کمیونٹیز کا استحکام"],
        ["Building", "تعمیر"],
        ["Value", "قدر"],
        ["Strengthening", "استحکام"],
        ["Communities", "کمیونٹیز"],

        ["Principal Facility", "اہم صنعتی سہولیات"],
        ["Shakarganj Foundation", "شکر گنج فاؤنڈیشن"],
        ["SSRI", "ایس ایس آر آئی"],

        ["Ethyl Alcohol", "ایتھائل الکحل"],
        ["Denatured Spirit", "ڈی نیچرڈ اسپرٹ"],
        ["Methylated Spirit", "میثائیلیٹڈ اسپرٹ"],
        ["Fuel Bioethanol", "فیول بائیو ایتھنول"],
        ["Bioethanol", "بائیو ایتھنول"],
        ["Denatured", "ڈی نیچرڈ"],
        ["Methylated", "میثائیلیٹڈ"],
        ["Spirit", "اسپرٹ"],
        ["CSR", "سی ایس آر"],

        // Mottos & Banners
        ["Excellence Isn't Luck. It's a Track Record.", "فضیلت کوئی اتفاق نہیں، یہ ہمارا روشن ریکارڈ ہے۔"],
        ["Excellence Isn't Luck", "فضیلت کوئی اتفاق نہیں"],
        ["Excellence Isn't an Accident. It's a Track Record.", "فضیلت کوئی اتفاق نہیں، یہ ہمارا روشن ریکارڈ ہے۔"],
        ["Excellence Isn't an Accident", "فضیلت کوئی اتفاق نہیں"],
        ["It's a Track Record", "یہ ہمارا روشن ریکارڈ ہے"],

        ["Sustainable Industrial Excellence Since 1967", "1967ء سے پائیدار صنعتی فضیلت"],
        ["50+ Years of Corporate Legacy", "50+ سالہ کارپوریٹ وراثت"],
        ["Leading Diversified Industrial Group", "پاکستان کا سرفہرست کثیر الشعبہ صنعتی گروپ"],
        ["High-Grade Refined Sugar", "اعلیٰ معیار کی ریفائنڈ شوگر"],
        ["Anhydrous Biofuel Ethanol", "ایکو فرینڈلی ایندھن کا بائیو ایتھنول"],

        ["Notices & Updates", "اطلاعات اور اپ ڈیٹس"],
        ["Quick Links", "اہم لنکس"],
        ["Company Profile", "کمپنی پروفائل"],
        ["Financial Highlights", "مالیاتی جھلکیاں"],
        ["Search portal...", "پورٹل تلاش کریں..."],
        ["Search", "تلاش کریں"],

        // Single Words & Menu Items
        ["Home", "صفحہ اول"],
        ["About Us", "ہمارے بارے میں"],
        ["Segments", "ہمارے شعبہ جات"],
        ["Sugar", "شوگر"],
        ["Biofuels", "بائیو فیول"],
        ["Investor Relations", "سرمایہ کار پورٹل"],
        ["Sustainability", "پائیداری"],
        ["Media", "میڈیا"],
        ["Contact Us", "رابطہ کریں"],
        ["Careers", "ملازمت کے مواقع"]
      ];

      function escapeRegex(str) {
        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      }

      // Recursive Text Node Walker that translates all text nodes inside any HTML structure
      function translateDOMNode(node, lang) {
        if (node.nodeType === Node.TEXT_NODE) {
          const raw = node.nodeValue;
          if (!raw || !raw.trim()) return;

          if (!node._origValue) {
            node._origValue = raw;
          }

          if (lang === 'ur') {
            let val = node._origValue;
            for (const [en, ur] of translationList) {
              if (val.includes(en)) {
                val = val.replace(new RegExp(escapeRegex(en), 'g'), ur);
              }
            }
            node.nodeValue = val;
          } else {
            node.nodeValue = node._origValue;
          }
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const tag = node.tagName;
          if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'INPUT' || tag === 'TEXTAREA' || node.id === 'live_results_dropdown' || node.id === 'footer_live_dropdown') {
            return;
          }
          for (let i = 0; i < node.childNodes.length; i++) {
            translateDOMNode(node.childNodes[i], lang);
          }
        }
      }

      function applyLanguage(lang) {
        const html = document.documentElement;
        if (lang === 'ur') {
          html.setAttribute('lang', 'ur');
          html.setAttribute('dir', 'rtl');
        } else {
          html.setAttribute('lang', 'en-US');
          html.setAttribute('dir', 'ltr');
        }

        // Run deep text node walker across entire body
        translateDOMNode(document.body, lang);

        // Sync dropdown selectors
        const langDropdowns = document.querySelectorAll('#lang_select, .lang_dropdown');
        langDropdowns.forEach(select => {
          select.value = lang;
        });

        localStorage.setItem('sml_lang', lang);
      }

      window.applyCurrentLanguage = function() {
        const savedLang = localStorage.getItem('sml_lang') || 'en';
        applyLanguage(savedLang);
      };

      // Initialize language on DOM Ready
      document.addEventListener('DOMContentLoaded', () => {
        const savedLang = localStorage.getItem('sml_lang') || 'en';
        if (savedLang === 'ur') {
          applyLanguage('ur');
        }

        document.addEventListener('change', (e) => {
          if (e.target && (e.target.id === 'lang_select' || e.target.classList.contains('lang_dropdown'))) {
            applyLanguage(e.target.value);
          }
        });
      });

      // Scroll to Top
      const scrollBtn = document.getElementById('scroll-to-top');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          if (scrollBtn) scrollBtn.style.display = 'flex';
        } else {
          if (scrollBtn) scrollBtn.style.display = 'none';
        }
      });
      scrollBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>
