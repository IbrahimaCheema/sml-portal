---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
  image?: string;
  type?: string;
  canonical?: string;
}

const { 
  title = "Shakarganj Limited - SML | Premier Sugar, Biofuels & Energy Group",
  description = "Shakarganj Limited (SML), incorporated in 1967, is a leading diversified industrial group in Pakistan producing high-grade refined sugar, biofuels, bio-energy, and textiles.",
  isHome = false,
  image = "https://docs.sml.com.pk/images/sml_logo.png",
  type = "website",
  canonical
} = Astro.props;

const siteUrl = "https://www.sml.com.pk";
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Shakarganj Limited",
  "legalName": "Shakarganj Limited",
  "alternateName": ["SML", "Shakarganj"],
  "url": siteUrl,
  "logo": "https://docs.sml.com.pk/images/sml_logo.png",
  "foundingDate": "1967",
  "tickerSymbol": "PSX:SML",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "E-10, Main Boulevard, Gulberg III",
    "addressLocality": "Lahore",
    "addressRegion": "Punjab",
    "postalCode": "54660",
    "addressCountry": "PK"
  },
  "contactPoint": [
    {
      "@type": "ContactPoint",
      "telephone": "+92-42-35757108",
      "contactType": "corporate office",
      "email": "info@shakarganj.pk",
      "areaServed": "PK",
      "availableLanguage": ["English", "Urdu"]
    },
    {
      "@type": "ContactPoint",
      "telephone": "+92-47-111-111-117",
      "contactType": "head office",
      "areaServed": "PK"
    }
  ],
  "sameAs": [
    "https://www.facebook.com/ShakarganjLimited",
    "https://www.linkedin.com/company/shakarganj-limited"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Shakarganj Limited",
  "alternateName": "SML",
  "url": siteUrl,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/search?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};
---

<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Shakarganj, Shakarganj Limited, SML, Shakarganj Sugar, Shakarganj Biofuels, Shakarganj Pakistan, SML Portal, Refined Sugar Pakistan, Bioethanol Pakistan" />
    <meta name="author" content="Shakarganj Limited" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content="Shakarganj Limited" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon & Apple Touch Icons -->
    <link rel="icon" type="image/png" href="https://docs.sml.com.pk/images/favicon.png" />
    <link rel="apple-touch-icon" href="https://docs.sml.com.pk/images/favicon.png" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Noto+Naskh+Arabic:wght@400;500;600;700&family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <!-- Immediate Inline Script to prevent FOUC for saved language -->
    <script is:inline>
      try {
        const savedLang = localStorage.getItem('sml_lang');
        if (savedLang === 'ur') {
          document.documentElement.setAttribute('lang', 'ur');
          document.documentElement.setAttribute('dir', 'rtl');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <div id="wrapper">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer isHome={isHome} />
    </div>

    <!-- Floating Corporate Social Media Dock -->
    <div class="floating_social_dock" aria-label="Official Social Media Pages">
      <a href="https://www.facebook.com/ShakarganjLimited" target="_blank" rel="noopener noreferrer" class="dock_btn fb" aria-label="Facebook" title="Shakarganj Facebook Page">
        <svg class="social_svg fb_svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        <span class="dock_label">Facebook</span>
      </a>
      <a href="https://www.linkedin.com/company/shakarganj-limited" target="_blank" rel="noopener noreferrer" class="dock_btn li" aria-label="LinkedIn" title="Shakarganj LinkedIn Page">
        <svg class="social_svg li_svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
        <span class="dock_label">LinkedIn</span>
      </a>
    </div>

    <!-- Scroll to Top Button -->
    <button id="scroll-to-top" aria-label="Scroll to top">
      <i class="fa fa-chevron-up"></i>
    </button>

    <style is:global>
      /* Jameel Noori Nastaleeq Font Definition */
      @font-face {
        font-family: 'Jameel Noori Nastaleeq';
        src: url('/fonts/JameelNooriNastaleeq.woff') format('woff'),
             url('https://docs.sml.com.pk/fonts/JameelNooriNastaleeq.woff') format('woff'),
             url('https://cdn.jsdelivr.net/gh/tariq-abdullah/urdu-web-font-CDN/JameelNooriNastaleeq.woff') format('woff');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      /* Unified Approved Jameel Noori Nastaleeq Font Style for Urdu Across the Entire Board */
      html[lang="ur"],
      html[dir="rtl"],
      html[lang="ur"] body, html[lang="ur"] h1, html[lang="ur"] h2, html[lang="ur"] h3, html[lang="ur"] h4, html[lang="ur"] h5, html[lang="ur"] h6,
      html[lang="ur"] p, html[lang="ur"] a, html[lang="ur"] span, html[lang="ur"] button, html[lang="ur"] div,
      html[lang="ur"] li, html[lang="ur"] input, html[lang="ur"] select, html[lang="ur"] strong, html[lang="ur"] b, html[lang="ur"] mark,
      html[dir="rtl"] body, html[dir="rtl"] h1, html[dir="rtl"] h2, html[dir="rtl"] h3, html[dir="rtl"] h4, html[dir="rtl"] h5, html[dir="rtl"] h6,
      html[dir="rtl"] p, html[dir="rtl"] a, html[dir="rtl"] span, html[dir="rtl"] button, html[dir="rtl"] div,
      html[dir="rtl"] li, html[dir="rtl"] input, html[dir="rtl"] select, html[dir="rtl"] strong, html[dir="rtl"] b, html[dir="rtl"] mark {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', 'Poppins', serif !important;
      }

      /* CRITICAL: Never apply letter-spacing to Arabic/Urdu scripts (causes detached glyphs) */
      html[lang="ur"] *,
      html[dir="rtl"] * {
        letter-spacing: normal !important;
      }

      html[lang="ur"] body,
      html[dir="rtl"] body {
        direction: rtl !important;
        text-align: right !important;
        line-height: 1.9 !important;
      }
      html[dir="rtl"] h1, html[dir="rtl"] h2, html[dir="rtl"] h3, html[dir="rtl"] h4 {
        line-height: 1.8 !important;
        padding-top: 4px;
        padding-bottom: 4px;
      }
      html[dir="rtl"] p {
        line-height: 2.1 !important;
      }

      /* Navigation & Submenus */
      html[dir="rtl"] .top_bar_right {
        direction: ltr;
      }
      html[dir="rtl"] .top_bar_address_row {
        direction: rtl !important;
        font-size: 14px !important;
      }
      html[dir="rtl"] .phone_box,
      html[dir="rtl"] .psx_stock_pill {
        direction: ltr !important;
        display: inline-flex !important;
        font-family: var(--font-main) !important;
      }
      html[dir="rtl"] .main_menu {
        direction: rtl !important;
      }
      html[dir="rtl"] .main_menu > li > a {
        font-family: 'Jameel Noori Nastaleeq', serif !important;
        font-size: 18px !important;
        line-height: 1.8 !important;
      }
      html[dir="rtl"] .main_menu > li > a i {
        margin-right: 4px;
        margin-left: 0;
      }

      /* Submenu Dropdown in RTL */
      html[dir="rtl"] .has-dropdown .sub-menu {
        right: 0 !important;
        left: auto !important;
        text-align: right !important;
        min-width: 240px !important;
      }
      html[dir="rtl"] .sub-menu a {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 16px !important;
        line-height: 2.1 !important;
        text-align: right !important;
        padding: 8px 18px !important;
      }
      html[dir="rtl"] .sub-menu a:hover {
        padding-right: 24px !important;
        padding-left: 18px !important;
      }

      /* Mobile Navigation Drawer in RTL */
      html[dir="rtl"] .mobile_menu_nav {
        direction: rtl !important;
        text-align: right !important;
      }
      html[dir="rtl"] .mobile_single_link,
      html[dir="rtl"] .mobile_item_row,
      html[dir="rtl"] .mobile_sub_menu a {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 17px !important;
        line-height: 1.9 !important;
        text-align: right !important;
      }
      html[dir="rtl"] .mobile_sub_menu {
        padding-right: 15px;
        padding-left: 0;
      }

      /* Notices & Cards */
      html[dir="rtl"] .notices_header_flex {
        direction: rtl !important;
      }
      html[dir="rtl"] .view_all_link {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 15px !important;
        flex-direction: row-reverse !important;
      }
      html[dir="rtl"] .view_all_link i {
        transform: rotate(180deg) !important;
      }
      html[dir="rtl"] .notice_card {
        direction: rtl !important;
        text-align: right !important;
      }
      html[dir="rtl"] .notice_title {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 18px !important;
        line-height: 1.7 !important;
        text-align: right !important;
      }
      html[dir="rtl"] .notice_cat_badge {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 13px !important;
        line-height: 1.6 !important;
        text-transform: none !important;
        padding: 3px 10px !important;
      }
      html[dir="rtl"] .notice_date {
        direction: rtl !important;
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 14px !important;
        justify-content: flex-start !important;
        gap: 8px !important;
      }

      /* Complaint & SECP Section */
      html[dir="rtl"] .complaint_content h3 {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 26px !important;
        line-height: 1.8 !important;
      }
      html[dir="rtl"] .complaint_content p {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 16px !important;
        line-height: 2.2 !important;
        text-align: center !important;
      }

      /* Footer */
      html[dir="rtl"] .footer_grid {
        direction: rtl !important;
        text-align: right !important;
      }
      html[dir="rtl"] .footer_title {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 20px !important;
        line-height: 1.8 !important;
        text-align: right !important;
      }
      html[dir="rtl"] .about_text {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 15px !important;
        line-height: 2.1 !important;
        text-align: right !important;
      }
      html[dir="rtl"] .registration_info li {
        text-align: right !important;
      }
      html[dir="rtl"] .registration_info strong {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 15px !important;
      }
      html[dir="rtl"] .registration_info span {
        direction: ltr !important;
        text-align: right !important;
        display: inline-block !important;
        font-family: var(--font-main) !important;
      }
      html[dir="rtl"] .footer_links {
        text-align: right !important;
      }
      html[dir="rtl"] .footer_links a {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 16px !important;
        line-height: 2.0 !important;
      }
      html[dir="rtl"] .footer_search_form {
        display: flex !important;
        flex-direction: row-reverse !important;
      }
      html[dir="rtl"] .footer_search_form input {
        direction: rtl !important;
        text-align: right !important;
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 14px !important;
      }
      html[dir="rtl"] .footer_search_form button {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 16px !important;
      }
      html[dir="rtl"] .updated_timestamp {
        text-align: right !important;
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 14px !important;
      }
      html[dir="rtl"] .copyright_flex {
        direction: rtl !important;
      }
      html[dir="rtl"] .copyright_text {
        font-family: 'Jameel Noori Nastaleeq', 'Noto Naskh Arabic', serif !important;
        font-size: 15px !important;
      }

      /* Home Page Elements */
      html[dir="rtl"] .read_more, html[dir="rtl"] .result_link {
        font-family: 'Jameel Noori Nastaleeq', serif !important;
        font-size: 16px !important;
        flex-direction: row-reverse !important;
        justify-content: flex-end !important;
      }
      html[dir="rtl"] .read_more i,
      html[dir="rtl"] .result_link i {
        transform: rotate(180deg);
        display: inline-block;
      }
      html[dir="rtl"] .card_header {
        flex-direction: row-reverse !important;
        justify-content: flex-end !important;
      }
      html[dir="rtl"] .card_title {
        font-size: 20px !important;
        line-height: 1.8 !important;
      }
      html[dir="rtl"] .card_text {
        font-size: 15px !important;
        line-height: 2.1 !important;
        text-align: right !important;
      }
      html[dir="rtl"] .motto_title {
        font-size: 34px !important;
        line-height: 1.8 !important;
      }
      html[dir="rtl"] .stat_label {
        font-size: 16px !important;
        line-height: 1.6 !important;
      }
      html[dir="rtl"] .stat_number {
        direction: ltr !important;
        display: inline-block !important;
      }
      html[dir="rtl"] .stakeholder_card {
        flex-direction: row-reverse !important;
        text-align: right !important;
      }
      html[dir="rtl"] .stakeholder_card .card_text h3 {
        font-size: 20px !important;
        line-height: 1.8 !important;
      }
      html[dir="rtl"] .stakeholder_card .card_text p {
        font-size: 15px !important;
        line-height: 2.0 !important;
        text-align: right !important;
      }
      html[dir="rtl"] .product_details h3 {
        font-size: 28px !important;
        line-height: 1.8 !important;
      }
      html[dir="rtl"] .product_details .description {
        font-size: 15px !important;
        line-height: 2.1 !important;
        text-align: right !important;
      }
      html[dir="rtl"] .availability {
        border-left: none !important;
        border-right: 4px solid var(--primary-color) !important;
        text-align: right !important;
      }
      html[dir="rtl"] .availability strong,
      html[dir="rtl"] .availability span {
        font-size: 16px !important;
      }

      #scroll-to-top {
        position: fixed;
        bottom: 25px;
        right: 25px;
        width: 42px;
        height: 42px;
        background-color: var(--primary-color);
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        display: none;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        z-index: 999;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
      }
      #scroll-to-top:hover {
        background-color: #222;
      }

      @media (max-width: 768px) {
        #scroll-to-top {
          bottom: 15px;
          right: 15px;
          width: 36px;
          height: 36px;
          font-size: 14px;
          opacity: 0.85;
        }
      }
    </style>

    <!-- Recursive Deep Text Node Urdu Translation Engine -->
    <script is:inline>
      const rawTranslationList = [
        // ==========================================
        // 1. NOTICES & UPDATES — TITLES & FULL PHRASES (Exact matches prevent BiDi scrambling)
        // ==========================================
        ["Board Meeting Other Than Financial Results", "بورڈ کا اجلاس (بغیر مالیاتی نتائج)"],
        ["Transmission of Quarterly Report for the Period Ended June 30, 2026", "30 جون 2026ء کو ختم ہونے والے عرصے کی سہ ماہی رپورٹ کی ترسیل"],
        ["Notice of Board of Directors Meeting", "بورڈ آف ڈائریکٹرز کے اجلاس کا نوٹس"],
        ["Financial results for the Half Year Ended 31 Mar 2026", "31 مارچ 2026ء کو ختم ہونے والے نصف سال کے مالیاتی نتائج"],
        ["Notice of Extraordinary General Meeting", "غیر معمولی جنرل اجلاس کا نوٹس"],
        ["Corporate Briefing Session 2025", "کارپوریٹ بریفنگ سیشن 2025ء"],
        ["Quarterly Report for the Period Ended 31 December 2025", "31 دسمبر 2025ء کو ختم ہونے والے عرصے کی سہ ماہی رپورٹ"],
        ["Annual Report for the Year Ended 30 September 2025", "30 ستمبر 2025ء کو ختم ہونے والے سال کی سالانہ رپورٹ"],
        ["Notice of Annual General Meeting", "سالانہ جنرل اجلاس کا نوٹس"],
        ["Notice Of Annual General Meeting", "سالانہ جنرل اجلاس کا نوٹس"],
        ["Financial results for the 3rd Quarter Ended 30 June 2025", "30 جون 2025ء کو ختم ہونے والی تیسری سہ ماہی کے مالیاتی نتائج"],
        ["Financial results for the Half Year Ended 31 Mar 2025", "31 مارچ 2025ء کو ختم ہونے والے نصف سال کے مالیاتی نتائج"],
        ["Corporate Briefing Session 2024", "کارپوریٹ بریفنگ سیشن 2024ء"],
        ["Quarterly Report for the Period Ended 31 December 2024", "31 دسمبر 2024ء کو ختم ہونے والے عرصے کی سہ ماہی رپورٹ"],
        ["Annual Report for the Year Ended 30 September 2024", "30 ستمبر 2024ء کو ختم ہونے والے سال کی سالانہ رپورٹ"],
        ["Financial results for the 3rd Quarter Ended 30 June 2024", "30 جون 2024ء کو ختم ہونے والی تیسری سہ ماہی کے مالیاتی نتائج"],
        ["Financial results for the Half Year Ended 31 Mar 2024", "31 مارچ 2024ء کو ختم ہونے والے نصف سال کے مالیاتی نتائج"],
        ["Corporate Briefing Session FY 2023", "کارپوریٹ بریفنگ سیشن مالی سال 2023ء"],
        ["Quarterly Report for the Period Ended 31 December 2023", "31 دسمبر 2023ء کو ختم ہونے والے عرصے کی سہ ماہی رپورٹ"],
        ["Annual Report for the Year Ended 30 September 2023", "30 ستمبر 2023ء کو ختم ہونے والے سال کی سالانہ رپورٹ"],
        ["Notice of Election of Directors (EOGM)", "ڈائریکٹرز کے انتخاب کا نوٹس (EOGM)"],
        ["Notice of Election of Directors", "ڈائریکٹرز کے انتخاب کا نوٹس"],
        ["Election of Directors (01 June 2026)", "ڈائریکٹرز کا انتخاب (01 جون 2026ء)"],
        ["Election of Directors Results 2026", "ڈائریکٹرز کے انتخاب کے نتائج 2026ء"],
        ["Report of Scrutinizer 2026", "اسکروٹنائزر کی رپورٹ 2026ء"],
        ["Election of Directors", "ڈائریکٹرز کا انتخاب"],

