        ["Zero-Waste Sustainable Model", "زیرو ویسٹ پائیدار ماڈل"],
        ["read more", "مزید تفصیلات"],
        ["READ MORE", "مزید تفصیلات"]
      ];

      function escapeRegex(str) {
        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      }

      // Recursive Text Node Walker that translates all text nodes inside any HTML structure
      function translateDOMNode(node, lang) {
        if (node.nodeType === Node.TEXT_NODE) {
          const raw = node.nodeValue;
          if (!raw || !raw.trim()) return;

          if (!node._origValue) {
            node._origValue = raw;
          }

          if (lang === 'ur') {
            let val = node._origValue;
            for (const [en, ur] of translationList) {
              if (val.includes(en)) {
                val = val.replace(new RegExp(escapeRegex(en), 'g'), ur);
              }
            }
            node.nodeValue = val;
          } else {
            node.nodeValue = node._origValue;
          }
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          const tag = node.tagName;
          if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'INPUT' || tag === 'TEXTAREA' || node.id === 'live_results_dropdown' || node.id === 'footer_live_dropdown') {
            return;
          }
          for (let i = 0; i < node.childNodes.length; i++) {
            translateDOMNode(node.childNodes[i], lang);
          }
        }
      }

      function applyLanguage(lang) {
        const html = document.documentElement;
        if (lang === 'ur') {
          html.setAttribute('lang', 'ur');
          html.setAttribute('dir', 'rtl');
        } else {
          html.setAttribute('lang', 'en-US');
          html.setAttribute('dir', 'ltr');
        }

        // Run deep text node walker across entire body
        translateDOMNode(document.body, lang);

        // Sync dropdown selectors
        const langDropdowns = document.querySelectorAll('#lang_select, .lang_dropdown');
        langDropdowns.forEach(select => {
          select.value = lang;
        });

        localStorage.setItem('sml_lang', lang);
      }

      window.applyCurrentLanguage = function() {
        const savedLang = localStorage.getItem('sml_lang') || 'en';
        applyLanguage(savedLang);
      };

      // Initialize language on DOM Ready
      document.addEventListener('DOMContentLoaded', () => {
        const savedLang = localStorage.getItem('sml_lang') || 'en';
        if (savedLang === 'ur') {
          applyLanguage('ur');
        }

        document.addEventListener('change', (e) => {
          if (e.target && (e.target.id === 'lang_select' || e.target.classList.contains('lang_dropdown'))) {
            applyLanguage(e.target.value);
          }
        });
      });

      // Scroll to Top
      const scrollBtn = document.getElementById('scroll-to-top');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
          if (scrollBtn) scrollBtn.style.display = 'flex';
        } else {
          if (scrollBtn) scrollBtn.style.display = 'none';
        }
      });
      scrollBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>
