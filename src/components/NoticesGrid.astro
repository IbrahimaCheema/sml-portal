---
import { newsPosts } from '../data/newsPosts';

// Get latest 4 posts
const latestNotices = newsPosts.slice(0, 4);
---

<section class="notices_section">
  <div class="container">
    <div class="notices_header_flex">
      <h2 class="section_title">Notices & Updates</h2>
      <a href="/blog" class="view_all_link">
        View All Notices <i class="fa fa-arrow-right"></i>
      </a>
    </div>

    <div class="notices_grid">
      {latestNotices.map((notice) => (
        <div class="notice_card move">
          <div class="notice_image">
            <a href={notice.pdfUrl || notice.linkUrl} target={notice.pdfUrl ? "_blank" : "_self"}>
              <img 
                src={notice.featuredImage} 
                alt={notice.title} 
                width="350" 
                height="250" 
                loading="lazy" 
                onerror="this.src='https://docs.sml.com.pk/images/report_2026_q2_thumb.jpg'"
              />
            </a>
            <span class="notice_cat_badge">{notice.category}</span>
          </div>
          <div class="notice_body">
            <h3 class="notice_title">
              <a href={notice.pdfUrl || notice.linkUrl} target={notice.pdfUrl ? "_blank" : "_self"}>
                {notice.title}
              </a>
            </h3>
            <div class="notice_date">
              <i class="fa fa-calendar"></i> {notice.displayDate}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .notices_section {
    padding: 70px 0;
    background-color: #f9f9f9;
  }
  .notices_header_flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 35px;
    flex-wrap: wrap;
    gap: 15px;
  }
  .section_title {
    font-size: 32px;
    font-family: var(--font-heading);
    font-weight: 700;
    color: #222222;
    margin: 0;
  }

  .view_all_link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    border-radius: 20px;
    background: var(--primary-color);
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 2px 6px rgba(46, 125, 50, 0.25);
  }

  .view_all_link:hover {
    background: var(--primary-hover);
    transform: translateX(3px);
  }

  .notice_image {
    position: relative;
  }

  .notice_cat_badge {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 3px 8px;
    background: rgba(15, 23, 42, 0.85);
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    backdrop-filter: blur(4px);
  }

  .notices_grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
  }

  .notice_card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  }

  .notice_image img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .notice_body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .notice_title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    font-family: var(--font-heading);
    margin-bottom: 12px;
  }
  .notice_title a {
    color: #333333;
  }
  .notice_title a:hover {
    color: var(--primary-color);
  }

  .notice_date {
    font-size: 12px;
    color: #888888;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 991px) {
    .notices_grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 576px) {
    .notices_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
