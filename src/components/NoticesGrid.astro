---
const notices = [
  {
    image: "https://docs.sml.com.pk/images/notice-q2-2026.jpg",
    title: "Condensed Interim Financial Information for Half Year Ended March 31, 2026",
    link: "https://www.sml.com.pk/financial-reports/"
  },
  {
    image: "https://docs.sml.com.pk/images/notice-egm.png",
    title: "Notice of Extraordinary General Meeting (EGM)",
    link: "https://www.sml.com.pk/notice-of-general-meetings/"
  },
  {
    image: "https://docs.sml.com.pk/images/notice-corp-brief.png",
    title: "Corporate Briefing Session 2025 Presentation",
    link: "https://www.sml.com.pk/notices-and-updates/"
  },
  {
    image: "https://docs.sml.com.pk/images/notice-q1-2025.jpg",
    title: "Quarterly Report First Quarter Ended December 31, 2025",
    link: "https://www.sml.com.pk/financial-reports/"
  }
];
---

<section class="notices_section">
  <div class="container">
    <h2 class="section_title text-center">Notices & Updates</h2>

    <div class="notices_grid">
      {notices.map((notice) => (
        <div class="notice_card move">
          <div class="notice_image">
            <a href={notice.link}>
              <img src={notice.image} alt={notice.title} width="350" height="250" loading="lazy" />
            </a>
          </div>
          <div class="notice_body">
            <h3 class="notice_title">
              <a href={notice.link}>{notice.title}</a>
            </h3>
            <div class="notice_date">
              <i class="fa fa-calendar"></i> {notice.date}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .notices_section {
    padding: 70px 0;
    background-color: #f9f9f9;
  }
  .section_title {
    font-size: 38px;
    font-family: var(--font-heading);
    font-weight: 700;
    color: #222222;
    margin-bottom: 40px;
  }

  .notices_grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
  }

  .notice_card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  }

  .notice_image img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .notice_body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
  }

  .notice_title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
    font-family: var(--font-heading);
    margin-bottom: 12px;
  }
  .notice_title a {
    color: #333333;
  }
  .notice_title a:hover {
    color: var(--primary-color);
  }

  .notice_date {
    font-size: 12px;
    color: #888888;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 991px) {
    .notices_grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 576px) {
    .notices_grid {
      grid-template-columns: 1fr;
    }
  }
</style>
