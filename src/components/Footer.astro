---
interface Props {
  isHome?: boolean;
}

const { isHome } = Astro.props;

// Auto-detect if current page is main index page
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isMainIndex = isHome !== undefined 
  ? isHome 
  : (currentPath === '' || currentPath === '/index' || currentPath === '/index.html');
---

<footer id="footer" class={!isMainIndex ? 'compact_footer' : ''}>
  {isMainIndex && (
    <!-- Widgets Row (Rich Footer on Main Index Page Only) -->
    <div class="footer_widgets_row">
      <div class="container">
        <div class="footer_grid">
          <!-- Col 1 -->
          <div class="footer_col">
            <div class="footer_logo">
              <a href="/">
                <img src="https://docs.sml.com.pk/images/footer-logo.png" alt="Shakarganj Limited" width="182" height="60" />
              </a>
            </div>
            <p class="about_text">
              Shakarganj Limited, incorporated in 1967, is a leading diversified industrial group in Pakistan producing high-grade refined sugar, biofuels, and power.
            </p>
            <div class="footer_social_block">
              <span class="footer_social_label">Connect With Us:</span>
              <div class="footer_social_icons">
                <a href="https://www.facebook.com/ShakarganjLimited" target="_blank" rel="noopener noreferrer" class="social_icon fb" aria-label="Facebook" title="Facebook">
                  <svg class="social_svg fb_svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
                <a href="https://www.linkedin.com/company/shakarganj-limited" target="_blank" rel="noopener noreferrer" class="social_icon li" aria-label="LinkedIn" title="LinkedIn">
                  <svg class="social_svg li_svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Column 2: Registration / NTN -->
          <div class="footer_col">
            <h4 class="footer_title">Registration / NTN</h4>
            <ul class="registration_info">
              <li>
                <strong>Company Registration Number</strong>
                <span>0002546</span>
              </li>
              <li>
                <strong>National Tax Number</strong>
                <span>1413603-1</span>
              </li>
              <li>
                <strong>Sales Tax Number</strong>
                <span>04-06-1703-002-46</span>
              </li>
            </ul>
          </div>

          <!-- Column 3: Quick Links -->
          <div class="footer_col">
            <h4 class="footer_title">Quick Links</h4>
            <ul class="footer_links">
              <li><a href="https://www.sml.com.pk/company-profile/">Company Profile</a></li>
              <li><a href="/board-of-directors">Board of Directors</a></li>
              <li><a href="/financial-reports">Financial Reports</a></li>
              <li><a href="/shareholder-information">Shareholder's Information</a></li>
              <li><a href="https://www.sml.com.pk/notices-and-updates/">Notices & Updates</a></li>
              <li><a href="https://www.sml.com.pk/careers/">Careers</a></li>
            </ul>
          </div>

          <!-- Column 4: Search & Language -->
          <div class="footer_col" style="position: relative;">
            <!-- 1. Search Bar -->
            <form class="footer_search_form" action="/search" method="get">
              <input type="search" name="s" id="footer_search_input" placeholder="Search portal..." aria-label="Search portal" autocomplete="off" />
              <button type="submit">Search</button>
            </form>
            <div id="footer_live_dropdown" class="footer_live_dropdown_box"></div>

            <!-- 2. Language Dropdown -->
            <div class="language_selector">
              <label for="lang_select" class="lang_label">
                <i class="fa fa-globe"></i> Language / زبان
              </label>
              <select id="lang_select" class="lang_dropdown" aria-label="Select Language">
                <option value="en" selected>English</option>
                <option value="ur">اردو (Urdu)</option>
              </select>
            </div>

            <p class="updated_timestamp"><em>Updated on: 26 July, 2026</em></p>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- Copyright Row (Universal on All Pages) -->
  <div class="copyright_row">
    <div class="container copyright_flex">
      <div class="social_links">
        <a href="https://www.facebook.com/ShakarganjLimited" target="_blank" rel="noopener noreferrer" aria-label="Facebook" title="Facebook">
          <svg class="social_svg fb_svg" viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/shakarganj-limited" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
          <svg class="social_svg li_svg" viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.74a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
        </a>
      </div>
      <div class="copyright_text">
        Copyright © Shakarganj Limited
      </div>
    </div>
  </div>
</footer>

<style>
  #footer {
    background-color: var(--footer-bg);
    color: #a0a0a0;
    font-size: 13px;
    line-height: 1.6;
  }

  .compact_footer {
    background-color: var(--footer-dark) !important;
  }

  .footer_widgets_row {
    padding: 60px 0 40px;
  }

  .footer_grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  .footer_col {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .footer_logo img {
    margin-bottom: 10px;
  }
  .about_text {
    color: #999;
  }

  .footer_title {
    color: #ffffff;
    font-size: 16px;
    font-family: var(--font-heading);
    font-weight: 600;
    margin-bottom: 10px;
    border-bottom: 2px solid var(--primary-color);
    padding-bottom: 8px;
    display: inline-block;
  }

  .footer_links li {
    margin-bottom: 8px;
  }
  .footer_links a {
    color: #a0a0a0;
    transition: color 0.2s ease;
  }
  .footer_links a:hover {
    color: var(--primary-color);
  }

  .registration_info {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .registration_info li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .registration_info strong {
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
  }
  .registration_info span {
    color: #a0a0a0;
    font-size: 13px;
  }

  .footer_search_form {
    display: flex;
    gap: 5px;
    margin-top: 10px;
  }
  .footer_search_form input {
    flex-grow: 1;
    padding: 8px 12px;
    border: 1px solid #444;
    background: #181b1e;
    color: #fff;
    border-radius: 4px;
    outline: none;
  }
  .footer_search_form button {
    background: var(--primary-color);
    color: #fff;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 600;
  }
  .footer_search_form button:hover {
    background: var(--primary-hover);
  }

  .language_selector {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 15px;
  }
  .lang_label {
    font-size: 13px;
    color: #ffffff;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
  }
  .lang_label i {
    color: var(--primary-color);
  }
  .lang_dropdown {
    width: 100%;
    padding: 9px 12px;
    background: #181b1e;
    color: #ffffff;
    border: 1px solid #444444;
    border-radius: 4px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lang_dropdown:focus, .lang_dropdown:hover {
    border-color: var(--primary-color);
  }

  .updated_timestamp {
    font-size: 12px;
    color: #777;
    margin-top: 5px;
  }

  .footer_live_dropdown_box {
    display: none;
    position: absolute;
    top: 48px;
    left: 0;
    right: 0;
    background: #1e2429;
    border: 1px solid var(--primary-color);
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    z-index: 1000;
    max-height: 350px;
    overflow-y: auto;
  }
  .footer_live_item {
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .footer_live_item a {
    color: #ffffff;
    text-decoration: none;
    display: block;
  }
  .footer_live_item a:hover {
    color: var(--primary-color);
  }
  .footer_live_title {
    font-weight: 600;
    font-size: 13px;
  }
  .footer_live_cat {
    font-size: 10px;
    color: var(--primary-color);
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  /* Copyright Row */
  .copyright_row {
    background-color: var(--footer-dark);
    padding: 20px 0;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  .copyright_flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .social_links {
    display: flex;
    gap: 15px;
  }
  .social_links a {
    color: #888;
    font-size: 16px;
  }
  .social_links a:hover {
    color: var(--primary-color);
  }
  .copyright_text {
    color: #888888;
  }

  @media (max-width: 991px) {
    .footer_grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 576px) {
    .footer_grid {
      grid-template-columns: 1fr;
    }
    .copyright_flex {
      flex-direction: column;
      gap: 15px;
    }
  }
</style>

<script is:inline>
  const footerInput = document.getElementById('footer_search_input');
  const footerDropdown = document.getElementById('footer_live_dropdown');

  const footerPortalIndex = [
    { title: "Sugar & Allied Products Division", link: "https://www.sml.com.pk/sugar/", cat: "Segments", tags: ["sugar", "white sugar", "brown sugar", "refined", "sml", "shakarganj"] },
    { title: "Biofuels & Renewable Power", link: "https://www.sml.com.pk/biofuels/", cat: "Segments", tags: ["biofuel", "ethanol", "power", "sml", "shakarganj"] },
    { title: "Financial Reports & Highlights", link: "/financial-reports", cat: "Investor Relations", tags: ["financial", "reports", "quarterly", "annual", "sml", "shakarganj"] },
    { title: "Company Profile & 50+ Years Legacy", link: "https://www.sml.com.pk/company-profile/", cat: "About Us", tags: ["company", "profile", "history", "sml", "shakarganj"] },
    { 
      title: "Board of Directors & Executive Management", 
      link: "/board-of-directors", 
      cat: "Governance", 
      tags: [
        "board", "directors", "management", "governance", "executive", "ceo", "cfo", "cio", 
        "manzoor hussain", "pervez akhtar", "ali altaf saleem", "ali", "altaf", "saleem", "baber zaman", "adil qureshi", 
        "mustapha altaf saleem", "sana atif", "waqas shafeeq", "asif ali", "muhammad asif", "ibrahim cheema", "saifullah", "sml", "shakarganj"
      ] 
    },
    { 
      title: "Audit, HR & Risk Management Committees", 
      link: "/board-of-directors", 
      cat: "Committees", 
      tags: ["audit", "hr", "remuneration", "nomination", "risk", "management", "committees", "governance", "sml", "shakarganj"] 
    },
    { title: "Corporate Social Responsibility (CSR)", link: "https://www.sml.com.pk/csr/", cat: "Sustainability", tags: ["csr", "sustainability", "foundation", "sml", "shakarganj"] },
    { title: "Notices of General Meetings (EGM & CBS)", link: "https://www.sml.com.pk/notices-and-updates/", cat: "Notices", tags: ["notices", "egm", "cbs", "updates", "sml", "shakarganj"] },
    { title: "Complaint Handling Cell & SECP SDMS", link: "/shareholder-information", cat: "Regulatory", tags: ["complaint", "secp", "jama punji", "sdms", "sml", "shakarganj"] },
    { title: "Pattern of Shareholding, NTN & Shares", link: "https://www.sml.com.pk/pattern-of-shareholding/", cat: "Investor Relations", tags: ["shareholding", "ntn", "registration", "free float", "sml", "shakarganj"] },
    { title: "Careers & Opportunities", link: "https://www.sml.com.pk/careers/", cat: "HR", tags: ["careers", "jobs", "hiring", "sml", "shakarganj"] }
  ];

  if (footerInput && footerDropdown) {
    footerInput.addEventListener('input', (e) => {
      const term = e.target.value.trim().toLowerCase();
      if (!term) {
        footerDropdown.style.display = 'none';
        return;
      }
      const matches = footerPortalIndex.filter(item => {
        return item.title.toLowerCase().includes(term) || item.cat.toLowerCase().includes(term) || item.tags.some(t => t.includes(term));
      });
      if (matches.length === 0) {
        footerDropdown.innerHTML = `<div style="padding: 10px; font-size: 12px; color: #aaa;">No instant matches. Press enter to search.</div>`;
      } else {
        footerDropdown.innerHTML = matches.map(m => `
          <div class="footer_live_item">
            <a href="${m.link}">
              <div class="footer_live_cat">${m.cat}</div>
              <div class="footer_live_title">${m.title}</div>
            </a>
          </div>
        `).join('');
      }
      footerDropdown.style.display = 'block';
    });

    document.addEventListener('click', (e) => {
      if (!e.target.closest('#footer_search_input') && !e.target.closest('#footer_live_dropdown')) {
        footerDropdown.style.display = 'none';
      }
    });
  }
</script>
