<style>
  /* Sticky Main Header */
  #header {
    width: 100%;
    position: relative;
    z-index: 1000;
    background-color: #ffffff;
    transition: background-color 0.3s ease;
  }

  #header.is_sticky {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    animation: headerSlideDown 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #header.is_sticky .top_bar {
    display: none;
  }

  @keyframes headerSlideDown {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(0);
    }
  }

  /* Top bar */
  .top_bar {
    background-color: var(--dark-bg);
    color: #a0a0a0;
    font-size: 12px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .top_bar_info {
    display: flex;
    justify-content: flex-end;
    gap: 25px;
  }
  .top_bar_info li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .header_socials {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .header_socials a {
    color: #555555;
    font-size: 15px;
    transition: color 0.2s ease;
  }
  .header_socials a:hover {
    color: var(--primary-color);
  }

  .header_lang_wrapper {
    margin-left: 6px;
  }
  .header_lang_dropdown {
    padding: 4px 8px;
    background: #f1f5f9;
    color: #1e293b;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    outline: none;
  }
  .header_lang_dropdown:hover, .header_lang_dropdown:focus {
    border-color: var(--primary-color);
  }

  /* Header Top */
  .header_top {
    background: #ffffff;
    padding: 12px 0;
    position: relative;
  }
  .header_flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav_wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }
  .header_socials {
    display: flex;
    gap: 15px;
  }
  .header_socials a {
    color: #666;
    font-size: 14px;
  }
  .header_socials a:hover {
    color: var(--primary-color);
  }

  /* Main Menu */
  .main_menu {
    display: flex;
    gap: 25px;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 14px;
  }
  .main_menu > li {
    position: relative;
    padding: 10px 0;
  }
  .main_menu > li > a {
    color: #333333;
    display: flex;
    align-items: center;
    gap: 4px;
    text-transform: capitalize;
  }
  .main_menu > li:hover > a,
  .main_menu > li.active > a {
    color: var(--primary-color);
  }

  /* Dropdown Sub-menu */
  .has-dropdown .sub-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: #ffffff;
    min-width: 220px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    border-top: 3px solid var(--primary-color);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.25s ease;
    z-index: 200;
  }
  .has-dropdown:hover .sub-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .sub-menu li {
    border-bottom: 1px solid #f0f0f0;
  }
  .sub-menu li:last-child {
    border-bottom: none;
  }
  .sub-menu a {
    display: block;
    padding: 10px 18px;
    color: #555;
    font-size: 13px;
    font-family: var(--font-main);
  }
  .sub-menu a:hover {
    background-color: #f9f9f9;
    color: var(--primary-color);
    padding-left: 22px;
  }

  /* 3-Bar Green Hamburger Toggle Button */
  .mobile_toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 26px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    outline: none;
  }
  .hamburger_bar {
    width: 100%;
    height: 4px;
    background-color: #005000; /* Dark green matching sml.com.pk */
    border-radius: 2px;
    transition: all 0.3s ease;
  }
  .mobile_toggle.active .hamburger_bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile_toggle.active .hamburger_bar:nth-child(2) {
    opacity: 0;
  }
  .mobile_toggle.active .hamburger_bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Navigation Drawer */
  .mobile_menu_nav {
    display: none;
    background: #1f2327;
    border-top: 2px solid var(--primary-color);
    max-height: calc(100vh - 70px);
    overflow-y: auto;
  }
  .mobile_menu_nav.active {
    display: block;
  }
  .mobile_menu_list {
    display: flex;
    flex-direction: column;
  }
  .mobile_menu_list li {
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .mobile_single_link {
    display: block;
    padding: 14px 20px;
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
  }
  .mobile_item_row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 20px;
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    user-select: none;
    transition: background 0.2s ease;
  }
  .mobile_item_row:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--primary-color);
  }
  .arrow_icon {
    font-size: 16px;
    transition: transform 0.3s ease;
    color: #a0a0a0;
  }
  .mobile-has-sub.active .arrow_icon {
    transform: rotate(180deg);
    color: var(--primary-color);
  }
  .mobile_sub_menu {
    display: none;
    background: #14171a;
    border-left: 4px solid var(--primary-color);
  }
  .mobile_sub_menu.open {
    display: block;
  }
  .mobile_sub_menu a {
    display: block;
    font-size: 13.5px;
    color: #cccccc;
    padding: 11px 25px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .mobile_sub_menu a:hover {
    color: var(--primary-color);
    background-color: rgba(255,255,255,0.03);
  }

  @media (max-width: 991px) {
    .nav_wrapper {
      display: none;
    }
    .mobile_toggle {
      display: flex;
    }
    .top_bar_info {
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
    }
  }
</style>

<script>
  const header = document.getElementById('header');
  let headerHeight = header ? header.offsetHeight : 90;

  function updateHeaderHeight() {
    if (header && !header.classList.contains('is_sticky')) {
      headerHeight = header.offsetHeight;
    }
  }

  function handleStickyHeader() {
    if (window.scrollY > 40) {
      if (header && !header.classList.contains('is_sticky')) {
        updateHeaderHeight();
        document.body.style.paddingTop = `${headerHeight}px`;
        header.classList.add('is_sticky');
      }
    } else {
      if (header && header.classList.contains('is_sticky')) {
        header.classList.remove('is_sticky');
        document.body.style.paddingTop = '0px';
      }
    }
  }

  window.addEventListener('scroll', handleStickyHeader, { passive: true });
  window.addEventListener('resize', updateHeaderHeight, { passive: true });
  handleStickyHeader();

  const toggleBtn = document.getElementById('mobile_toggle_btn');
  const mobileMenu = document.getElementById('mobile_menu');
  
  toggleBtn?.addEventListener('click', () => {
    toggleBtn.classList.toggle('active');
    mobileMenu?.classList.toggle('active');
  });

  // Tap anywhere on parent row to toggle accordion submenus
  const subRows = document.querySelectorAll('.mobile_item_row');
  subRows.forEach(row => {
    row.addEventListener('click', () => {
      const parentLi = row.closest('.mobile-has-sub');
      const subMenu = parentLi?.querySelector('.mobile_sub_menu');
      parentLi?.classList.toggle('active');
      subMenu?.classList.toggle('open');
    });
  });
</script>
